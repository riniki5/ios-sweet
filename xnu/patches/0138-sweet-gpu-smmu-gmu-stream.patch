+/*
+ * The GMU's own kernel DMA - HFI queues, firmware log - is stream 5 of the
+ * GPU SMMU (live DT: qcom,gmu's gmu_kernel child, iommus = <&smmu 5>). No SMR
+ * matches it at boot and SMMU_GBPA is 0, so an unmatched transaction is
+ * terminated rather than bypassed; give the stream a bypass entry of its own
+ * so HFI does not depend on that policy.
+ */
+static void
+gpu_smmu_gmu_stream(void)
+{
+	unsigned groups, n;
+	uint32_t smr, s2cr;
+
+	if (!gpu_smmu) {
+		return;
+	}
+	groups = gpu_rd(gpu_smmu, SMMU_GR0_IDR0) & 0xffu;
+	if (groups > 64) {
+		groups = 64;
+	}
+	for (n = 0; n < groups; ++n) {
+		smr = gpu_rd(gpu_smmu, SMMU_GR0_SMR + 4 * n);
+		if (!(smr & SMMU_SMR_VALID)) {
+			break;
+		}
+		if ((smr & 0xffffu) == GMU_GMU_SID) {
+			s2cr = gpu_rd(gpu_smmu, SMMU_GR0_S2CR + 4 * n);
+			printf("SWEET GPU: smmu gmu sid %u already smr%u=%#x s2cr=%#x\n",
+			    GMU_GMU_SID, n, smr, s2cr);
+			return;
+		}
+	}
+	if (n == groups) {
+		printf("SWEET GPU: smmu gmu sid %u: no free SMR\n", GMU_GMU_SID);
+		return;
+	}
+	/* Program the entry before it can match, so the first GMU transaction
+	 * already sees BYPASS instead of the reset S2CR's fault type. */
+	gpu_wr(gpu_smmu, SMMU_GR0_S2CR + 4 * n, SMMU_S2CR_BYPASS);
+	gpu_wr(gpu_smmu, SMMU_GR0_SMR + 4 * n,
+	    SMMU_SMR_VALID | (GMU_GMU_SID & 0xffffu));
+	printf("SWEET GPU: smmu gmu sid %u smr%u=%#x s2cr=%#x scr0=%#x gbpa=%#x\n",
+	    GMU_GMU_SID, n, gpu_rd(gpu_smmu, SMMU_GR0_SMR + 4 * n),
+	    gpu_rd(gpu_smmu, SMMU_GR0_S2CR + 4 * n),
+	    gpu_rd(gpu_smmu, SMMU_GR0_SCR0), gpu_rd(gpu_smmu, SMMU_GR0_GBPA));
+}
+
+/* One line of SMMU fault state that a hung GMU would leave behind. */
+static void
+gpu_smmu_fault(const char *when)
+{
+	if (!gpu_smmu) {
+		return;
+	}
+	printf("SWEET GPU: smmu %s sgfsr=%#x synr0=%#x sid=%#x synr2=%#x\n",
+	    when, gpu_rd(gpu_smmu, SMMU_GR0_SGFSR),
+	    gpu_rd(gpu_smmu, SMMU_GR0_GFSYNR0), gpu_rd(gpu_smmu, SMMU_GR0_GFSYNR1),
+	    gpu_rd(gpu_smmu, SMMU_GR0_GFSYNR2));
+}
