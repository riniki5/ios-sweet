 /*
  * The GMU's own kernel DMA - HFI queues, firmware log - is stream 5 of the
- * GPU SMMU (live DT: qcom,gmu's gmu_kernel child, iommus = <&smmu 5>). The
- * boot chain leaves the client port enabled with sCR0.USFCFG set and every SMR
- * invalid, so an unmatched stream is terminated rather than bypassed.
+ * GPU SMMU (live DT: qcom,gmu's gmu_kernel child, iommus = <&smmu 5>).
  *
- * 0138 installed a SID-5 SMR before its S2CR, read the SMR back and got the
- * S2CR still reporting FAULT. The reference orders the pair valid-first and
- * finishes with USFCFG clear, so 0139 tries that, then falls back to leaving
- * the stream unmatched under a cleared USFCFG. Each write prints its readback:
- * one boot says which of these registers this SMMU lets EL1 change.
+ * 0139 proved the SMMU takes SMR and S2CR writes but will not be talked out of
+ * terminating unmatched streams, and its BYPASS type reads back as 2, so the
+ * only configuration left is translation: an identity map of the pool for
+ * group 1 / bank 1, built with the constants the reference proved on an A618,
+ * then probed with the SMMU's own ATS1PR before the CM3 is released.
  */
+static bool
+gpu_smmu_gmu_map(void)
+{
+	uint32_t bank, first2, last2, pages, i, va, scr0, tlb;
+	bool ok = true;
+
+	if (!gpu_smmu || !gpu_pool) {
+		printf("SWEET GPU: smmu map: no window or pool, gmu stream left"
+		    " alone\n");
+		return false;
+	}
+	bank = gpu_smmu_bank_base() + GMU_SMMU_BANK * 0x1000u;
+	if ((uint64_t)bank + 0x1000u > 0x10000u) {
+		printf("SWEET GPU: smmu map: bank %u at %#x is outside the window,"
+		    " nothing written\n", GMU_SMMU_BANK, bank);
+		return false;
+	}
+	pages = (uint32_t)(gpu_pool_size >> 12);
+	first2 = (gpu_pool_pa >> 21) & 511u;
+	last2 = (((uint64_t)gpu_pool_pa + gpu_pool_size - 1u) >> 21) & 511u;
+	for (i = 0; i < 0x4000u; i += 4u) {
+		gpu_pool_wr(i, 0);
+	}
+	gpu_pool_entry(GMU_POOL_L1, gpu_pool_pa >> 30,
+	    (uint64_t)(gpu_pool_pa + GMU_POOL_L2) | LPAE_TABLE);
+	gpu_pool_entry(GMU_POOL_L2, first2,
+	    (uint64_t)(gpu_pool_pa + GMU_POOL_L3) | LPAE_TABLE);
+	if (last2 != first2) {
+		gpu_pool_entry(GMU_POOL_L2, last2,
+		    (uint64_t)(gpu_pool_pa + GMU_POOL_L3B) | LPAE_TABLE);
+	}
+	for (i = 0; i < pages; ++i) {
+		va = gpu_pool_pa + i * 0x1000u;
+		gpu_pool_entry(((va >> 21) & 511u) == first2 ? GMU_POOL_L3 :
+		    GMU_POOL_L3B, (va >> 12) & 511u, (uint64_t)va | LPAE_PAGE);
+	}
+	gpu_wr(gpu_smmu, SMMU_GR1_CBA2R(GMU_SMMU_BANK), SMMU_CBA2R_VA64);
+	gpu_wr(gpu_smmu, SMMU_GR1_CBAR(GMU_SMMU_BANK), SMMU_CBAR_S1);
+	gpu_wr(gpu_smmu, bank + SMMU_CB_TCR2, SMMU_TCR2_36BIT);
+	gpu_wr64(gpu_smmu, bank + SMMU_CB_TTBR0,
+	    (uint64_t)(gpu_pool_pa + GMU_POOL_L1) |
+	    ((uint64_t)GMU_SMMU_BANK << 48));
+	gpu_wr(gpu_smmu, bank + SMMU_CB_TCR, SMMU_TCR_32BIT);
+	gpu_wr(gpu_smmu, bank + SMMU_CB_MAIR0, SMMU_MAIR0_VALUE);
+	gpu_wr(gpu_smmu, bank + SMMU_CB_MAIR1, 0);
+	gpu_wr(gpu_smmu, bank + SMMU_CB_FSR, ~0u);
+	gpu_wr(gpu_smmu, bank + SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+	gpu_wr(gpu_smmu, SMMU_GR0_S2CR + 4u * GMU_SMMU_GROUP, GMU_SMMU_BANK);
+	gpu_wr(gpu_smmu, SMMU_GR0_SMR + 4u * GMU_SMMU_GROUP,
+	    SMMU_SMR_VALID | GMU_GMU_SID);
+	printf("SWEET GPU: smmu map pool=%#x pages=%u l2=%u/%u cbar=%#x"
+	    " ttbr0=%#llx sctlr=%#x smr=%#x s2cr=%#x\n", gpu_pool_pa, pages,
+	    first2, last2, gpu_rd(gpu_smmu, SMMU_GR1_CBAR(GMU_SMMU_BANK)),
+	    (unsigned long long)gpu_rd64(gpu_smmu, bank + SMMU_CB_TTBR0),
+	    gpu_rd(gpu_smmu, bank + SMMU_CB_SCTLR),
+	    gpu_rd(gpu_smmu, SMMU_GR0_SMR + 4u * GMU_SMMU_GROUP),
+	    gpu_rd(gpu_smmu, SMMU_GR0_S2CR + 4u * GMU_SMMU_GROUP));
+	(void)sweet_log_sync();
+	gpu_wr(gpu_smmu, SMMU_TLBIALLNSNH, 0);
+	gpu_wr(gpu_smmu, SMMU_TLBGSYNC, 0);
+	for (i = 1; i <= 200; ++i) {
+		if (gpu_rd(gpu_smmu, SMMU_TLBGSTATUS) & 1u) {
+			break;
+		}
+		delay(100);
+	}
+	tlb = i <= 200u;
+	scr0 = gpu_rd(gpu_smmu, SMMU_GR0_SCR0);
+	gpu_wr(gpu_smmu, SMMU_GR0_SCR0,
+	    (scr0 & ~(SMMU_SCR0_CLIENTPD | SMMU_SCR0_USFCFG | SMMU_SCR0_FB)) |
+	    SMMU_SCR0_ENABLE_BITS);
+	printf("SWEET GPU: smmu map tlb=%u polls=%u scr0 %#x -> %#x\n", tlb,
+	    i, scr0, gpu_rd(gpu_smmu, SMMU_GR0_SCR0));
+	(void)sweet_log_sync();
+	gpu_wr(gpu_smmu, SMMU_GR0_SGFSR, gpu_rd(gpu_smmu, SMMU_GR0_SGFSR));
+	ok = tlb;
+	/* Both ends of what the firmware reads, then two addresses the tables do
+	 * not cover: the fault probes are expected and leave sGFSR set. */
+	ok &= gpu_smmu_probe(bank, gpu_pool_pa, TRUE);
+	ok &= gpu_smmu_probe(bank, gpu_pool_pa + GMU_POOL_LOG, TRUE);
+	ok &= gpu_smmu_probe(bank, gpu_pool_pa + GMU_POOL_HFI, TRUE);
+	ok &= gpu_smmu_probe(bank, gpu_pool_pa + GMU_POOL_DEBUG, TRUE);
+	ok &= gpu_smmu_probe(bank, gpu_pool_pa + (pages - 1u) * 0x1000u, TRUE);
+	ok &= gpu_smmu_probe(bank, gpu_pool_pa + 0x400000u, FALSE);
+	ok &= gpu_smmu_probe(bank, 0x60000000u, FALSE);
+	printf("SWEET GPU: smmu map %s sgfsr=%#x gfsynr0=%#x fsr=%#x\n",
+	    ok ? "verified" : "NOT VERIFIED", gpu_rd(gpu_smmu, SMMU_GR0_SGFSR),
+	    gpu_rd(gpu_smmu, SMMU_GR0_GFSYNR0),
+	    gpu_rd(gpu_smmu, bank + SMMU_CB_FSR));
+	(void)sweet_log_sync();
+	return ok;
+}
