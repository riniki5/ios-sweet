+/*
+ * 0139 wrote every SMMU register it could: SMR and S2CR writes land, but sCR0
+ * reads back with USFCFG set after a clear, and a BYPASS type (1) reads back as
+ * 2. Unmatched streams therefore have to be assumed terminated, and the GMU
+ * needs a real stage-1 mapping, which is what Linux builds on sc7180 and what
+ * the reference proved on an A618: group 1, bank 1, the constants below.
+ *
+ * GR1 is register page 1 and the context banks start one NUMPAGENDXB field
+ * later (arm-smmu.c arm_smmu_page()), hence gpu_smmu_bank_base() below.
+ */
+#define SMMU_GR1_BASE           0x1000u
+#define SMMU_GR1_CBAR(n)        (SMMU_GR1_BASE + 4u * (n))
+#define SMMU_GR1_CBA2R(n)       (SMMU_GR1_BASE + 0x800u + 4u * (n))
+#define SMMU_CB_SCTLR           0x00u
+#define SMMU_CB_TCR2            0x10u
+#define SMMU_CB_TTBR0           0x20u
+#define SMMU_CB_TCR             0x30u
+#define SMMU_CB_MAIR0           0x38u
+#define SMMU_CB_MAIR1           0x3cu
+#define SMMU_CB_PAR             0x50u
+#define SMMU_CB_FSR             0x58u
+#define SMMU_CB_ATS1PR          0x800u
+#define SMMU_CB_ATSR            0x8f0u
+#define SMMU_TLBIALLNSNH        0x068u
+#define SMMU_TLBGSYNC           0x070u
+#define SMMU_TLBGSTATUS         0x074u
+#define SMMU_CBAR_S1            0x0001f300u /* stage 1, stage 2 bypass, WB */
+#define SMMU_CBA2R_VA64         1u
+#define SMMU_TCR2_36BIT         0x00038001u /* 36-bit PA, SEP upstream */
+#define SMMU_TCR_32BIT          0x00802020u /* 32-bit VA, walk from L1, 4 KiB */
+#define SMMU_MAIR0_VALUE        0xf404ff44u /* attr 0: normal non-cacheable */
+#define SMMU_SCTLR_ON           0x00001027u /* M TRE AFE CFRE ASIDPNE */
+#define SMMU_PAR_FAULT          1u
+#define SMMU_PAR_PA             0x0000fffffffff000ull
+#define LPAE_TABLE              3ull
+#define LPAE_PAGE               0xf43ull
+#define GMU_SMMU_GROUP          1u
+#define GMU_SMMU_BANK           1u
+/* The pool's first 16 KiB were never used and hold the walk's tables. */
+#define GMU_POOL_L1             0x0000u
+#define GMU_POOL_L2             0x1000u
+#define GMU_POOL_L3             0x2000u
+#define GMU_POOL_L3B            0x3000u
