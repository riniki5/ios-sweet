+/* TTBR0, PAR and ATS1PR are 64-bit and all 8-byte aligned. */
+static uint64_t
+gpu_rd64(vm_offset_t base, uint32_t off)
+{
+	uint64_t v = *(volatile uint64_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gpu_wr64(vm_offset_t base, uint32_t off, uint64_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
