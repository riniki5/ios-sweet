 	if (!(v & CBCR_CLK_OFF)) {
+		if (!(v & CBCR_ENABLE)) {
+			gpu_wr(base, off, v | CBCR_ENABLE);
+			v = gpu_rd(base, off);
+			printf("SWEET GPU: %s @%#x was gated, now %#x\n", name, off, v);
+			return true;
+		}
+		printf("SWEET GPU: %s @%#x = %#x (on)\n", name, off, v);
 		return true;
 	}
+	printf("SWEET GPU: %s @%#x = %#x (off%s clk-off)\n", name, off, v,
+	    (v & CBCR_HW_CTL) ? " hw-ctl" : "");
 	if (v & CBCR_HW_CTL) {
 		/* Voted/HW branches are not ours to drive from SW. */
 		printf("SWEET GPU: %s is under HW control, leaving it alone\n", name);
