+/*
+ * 0147: the shader/GMEM path.  0145/0146 got the core register stage, the
+ * shader cores (HWCG + SPTPRAC) and the CP running: the ring, SQE and
+ * ME_INIT land and the CP goes idle.  What is missing is draws reaching the
+ * cores.  The adreno 6xx draw path is PM4 packets on the CP ring (the CP
+ * firmware fetches them): SELECT_CP_STATE, the dispatch packet; the CP
+ * reports progress in the pool.  Poll the CP: it should consume the ring
+ * and report no fault.  Run from gpu_gmu_full_boot(); boot arg
+ * gpu_dispatch=1 gates the first submit.  Verify PM4_DISPATCH against the
+ * vendor adreno_pm4.xml on the first boot.
+ */
+#define PM4_SELECT_CP_STATE    0x06u
+#define PM4_DISPATCH          0x8au
+
+static bool
+gpu_shader_dispatch(void)
+{
+	uint32_t i, polls = 0, fault;
+	int on = 0;
+
+	PE_parse_boot_argn("gpu_dispatch", &on, sizeof(on));
+	if (!on) {
+		return true;
+	}
+	printf("SWEET GPU: shader dispatch begin t=%llu\n", gpu_uptime_ms());
+	(void)sweet_log_sync();
+	/* SELECT_CP_STATE: the default state, then the draw. */
+	gpu_ring_push(gpu_pm4_type7(PM4_SELECT_CP_STATE, 1));
+	gpu_ring_push(0u);
+	gpu_ring_push(gpu_pm4_type7(PM4_DISPATCH, 0));
+	gpu_ring_flush();
+	for (i = 1; i <= 2000; ++i) {
+		if (gpu_rd(gpu_core, CORE_CP_RB_RPTR) == gpu_ring_wptr &&
+		    gpu_rd(gpu_core, CORE_CP_HW_FAULT) == 0) {
+			break;
+		}
+		delay(100);
+	}
+	polls = i;
+	fault = gpu_rd(gpu_core, CORE_CP_HW_FAULT);
+	printf("SWEET GPU: shader dispatch polls=%u rptr=%#x wptr=%#x fault=%#x"
+	    " rbbm=%#x t=%llu\n", polls <= 2000u ? polls : 0u,
+	    gpu_rd(gpu_core, CORE_CP_RB_RPTR), gpu_rd(gpu_core, CORE_CP_RB_WPTR),
+	    fault, gpu_rd(gpu_core, CORE_RBBM_STATUS), gpu_uptime_ms());
+	(void)sweet_log_sync();
+	gpu_core_state("dispatch");
+	return polls <= 2000u && fault == 0;
+}
