+  if (!error && resource.addr != address[r]) error = ENODEV;
+  if (!error) error = rh_arc_levels(&resource, levels[r], &counts[r]);
+  if (error) break;
+  /* MIN_SVS is raw 48 in the pinned RPMh bindings. The measured
+  * GFX/CX tables round this up to 64; MX rounds up to 192. */
+  unsigned i;
+  for (i = 0; i < counts[r]; ++i) {
+   --levels[r][i];
+   if (!selected[r] && levels[r][i] >= 48) selected[r] = i;
+  }
+  if (!selected[r] || levels[r][0] != 0) error = ERANGE;
+ }
+ if (!error) {
+  *gpu = (levels[0][selected[0]] << 16) | (selected[2] << 8) | selected[0];
+  *gmu = (levels[1][selected[1]] << 16) | (selected[2] << 8) | selected[1];
+ }
+ __atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+ return error;
+}
+
+/*
+ * One GPU performance level's wire vote, as Linux a6xx_gmu_rpmh_arc_votes_init:
+ * the first gfx.lvl entry at or above the OPP's raw level is primary; the
+ * first mx.lvl entry at or above it is secondary, else the highest nonzero
+ * one. *mx_level returns that secondary level for an APPS raise-only floor.
+ */
+int sweet_rpmh_adreno_level_vote(unsigned level, uint32_t *vote, unsigned *mx_level);
+int
+sweet_rpmh_adreno_level_vote(unsigned level, uint32_t *vote, unsigned *mx_level)
+{
+ if (!vote || !mx_level || !level) return EINVAL;
+ *vote = 0; *mx_level = 0;
+ if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) return EBUSY;
+ const char *names[] = {"gfx.lvl", "mx.lvl"};
+ const uint32_t address[] = {0x30050, 0x30010};
+ uint32_t levels[2][RH_ARC_MAX_LEVELS] = {{0}};
+ unsigned counts[2] = {0}, index[2] = {0};
+ bool found[2] = {false, false};
+ int error = rh_map();
+ for (unsigned r = 0; !error && r < 2; ++r) {
+  struct rh_res resource = {0};
+  error = rh_lookup(names[r], RH_ARC, &resource);
+  if (!error && resource.addr != address[r]) error = ENODEV;
+  if (!error) error = rh_arc_levels(&resource, levels[r], &counts[r]);
+  if (error) break;
+  for (unsigned i = 0; i < counts[r]; ++i) {
+   --levels[r][i];
+   if (!found[r] && levels[r][i] >= level) { index[r] = i; found[r] = true; }
+   else if (!found[r] && r == 1 && levels[r][i]) index[r] = i;
+  }
+  if (levels[r][0] != 0) error = ERANGE;
+ }
+ if (!error && !found[0]) error = ERANGE;
+ if (!error && !index[1]) error = ERANGE;
+ if (!error) {
+  *vote = (levels[0][index[0]] << 16) | (index[1] << 8) | index[0];
+  *mx_level = levels[1][index[1]];
+ }
+ __atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+ return error;
+}
+
+/*
+ * Read one ARC resource while the caller holds rh_lock. The same serialized
+ * ACTIVE TCS engine is used for reads and for the raise-only write below.
+ */
+static int
+rh_arc_read_locked(const char *res, struct rh_res *found,
+    uint32_t *level, unsigned *count, uint32_t *reply)
+{
+	int error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_ARC, found);
+	}
+	if (!error) {
+		error = rh_arc_levels(found, level, count);
+	}
+	if (!error) {
+		const uint32_t zero = 0;
+		error = rh_send_cmds(res, found->addr, 3u, &zero, &zero, 1,
+		    RH_ARC_TIMEOUT_US, reply);
+	}
+	return error;
+}
+
+/*
+ * ARC READ uses the same serialized ACTIVE TCS engine as the touch VRM.
+ * qcom-rpmh-mailbox.c defines READ by clearing MSGID.WRITE and retrieves
+ * CMD_RESP_DATA at 0x40. This does not change a resource vote, although it
+ * programs a TCS. Do not infer the retained APPS vote from the DT minimum.
+ *
+ * The meaning of an ARC reply must be established on this board before
+ * introducing a vote floor. Until then this API logs raw replies only.
+ */
+int
+sweet_rpmh_arc_read(const char *res)
+{
+	if (!rh_arc_name(res)) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	uint32_t level[RH_ARC_MAX_LEVELS] = {0};
+	unsigned count = 0;
+	uint32_t reply = 0xffffffffu;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC read\n");
+		goto out;
+	}
+	if (!rh_touch_ready) {
+		/* A failed experiment must not block the first touch-power vote. */
+		error = EAGAIN;
+		printf("SWEET RPMH: ARC read deferred: L11C has not completed\n");
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, level, &count, &reply);
+	if (!error) {
+		printf("SWEET RPMH: ARC %s reply=%#x table-count=%u\n",
+		    res, reply, count);
+		if (reply < count) {
+			printf("SWEET RPMH: ARC reply as index: vlvl=%u (interpretation unverified)\n",
+			    level[reply]);
+		} else {
+			printf("SWEET RPMH: ARC reply is not a plain table index\n");
+		}
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC read %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/* Check the current board's ARC selector interpretation without voting.
+ * Unlike arc_read(), this returns an error for off/out-of-range replies.
+ * This is a resource-setting check; it does not measure a rail voltage.
+ */
+int
+sweet_rpmh_arc_require(const char *res, unsigned minimum)
+{
+	if (!rh_arc_name(res) || minimum <= 1)
+		return EINVAL;
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE))
+		return EBUSY;
+	int error = EIO;
+	struct rh_res found = {0};
+	uint32_t levels[RH_ARC_MAX_LEVELS] = {0}, reply = 0xffffffffu;
+	unsigned count = 0;
+	if (rh_poisoned)
+		goto out;
+	if (!rh_touch_ready) {
+		error = EAGAIN;
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, levels, &count, &reply);
+	if (error)
+		goto out;
+	if (reply >= count) {
+		error = EIO;
+		goto out;
+	}
+	printf("SWEET RPMH: ARC require %s selector=%u interpreted-level=%u minimum=%u\n",
+	    res, reply, levels[reply], minimum);
+	if (levels[reply] < minimum)
+		error = EAGAIN;
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * 0149: a bus (BCM) vote from the kernel. The apps SMMU (0x15000000) sits
+ * behind the path its downstream node votes (msm-bus 161 -> 627 = BCMs SN15
+ * and CN0, active-only, 1000 KBps); 0131's wland stalled a CPU on its first
+ * apps-SMMU read with no such vote. Command: commit|valid|x<<14|y, as
+ * Linux's BCM_TCS_CMD. Only those two BCMs, only small nonzero levels.
+ */
+int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y)
+{
+	/* SN15/CN0: the apps SMMU's path (0149, tiny votes); MC0/SH0/ACV: the memory (0169) */
+	const bool memory = res && (!strcmp(res, "MC0") || !strcmp(res, "SH0") || !strcmp(res, "ACV"));
+	if (!res || (strcmp(res, "SN15") && strcmp(res, "CN0") && !memory) ||
+	    x > (memory ? 0x3fffu : 16u) || y > (memory ? 0x3fffu : 16u) || (!x && !y)) {
+		return EPERM;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, RH_BCM, &found);
+		}
+		if (!error) {
+			const uint32_t offset = 0, value = 1u << 30 | 1u << 29 | x << 14 | y;
+			error = rh_send_cmds(res, found.addr, 3u, &offset, &value, 1, RH_TIMEOUT_US, NULL);
+			printf("SWEET RPMH: BCM %s addr=%#x vote %#x -> %d\n", res, found.addr, value, error);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * Raise-only ARC vote. This is deliberately narrower than 0083's fixed
+ * votes: it reads the resource first, refuses a non-index reply, and never
+ * writes a selector below the current level. gfx.lvl and mx.lvl only: a
+ * GPU clock above the bootloader corner first raises both APPS floors so the
+ * rails cannot depend solely on the GMU's own votes. cx.lvl stays untouched.
+ */
+int
+sweet_rpmh_arc_raise(const char *res, unsigned target_vlvl)
+{
+	if (!res || (strcmp(res, "gfx.lvl") && strcmp(res, "mx.lvl")) || target_vlvl == 0) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	uint32_t level[RH_ARC_MAX_LEVELS] = {0};
+	unsigned count = 0;
+	uint32_t before = 0xffffffffu, after = 0xffffffffu;
+	unsigned selector = 0;
+
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC raise\n");
+		goto out;
+	}
+	if (!rh_touch_ready) {
+		error = EAGAIN;
+		printf("SWEET RPMH: ARC raise deferred: L11C has not completed\n");
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, level, &count, &before);
+	if (error) {
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise before=%#x table-count=%u target-vlvl=%u\n",
+	    res, before, count, target_vlvl);
+	if (before >= count) {
+		printf("SWEET RPMH: ARC %s reply is not a table index; refusing write\n", res);
+		error = EINVAL;
+		goto out;
+	}
+	if (level[before] >= target_vlvl) {
+		printf("SWEET RPMH: ARC %s already at/above vlvl=%u; no write\n",
+		    res, level[before]);
+		error = 0;
+		goto out;
+	}
+	for (selector = 0; selector < count; ++selector) {
+		if (level[selector] >= target_vlvl) {
+			break;
+		}
+	}
+	if (selector == 0 || selector >= count) {
+		printf("SWEET RPMH: ARC %s no safe selector >= target; refusing write\n", res);
+		error = ERANGE;
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise selector=%u vlvl=%u from=%#x vlvl=%u\n",
+	    res, selector, level[selector], before, level[before]);
+	{
+		const uint32_t offset = 0;
+		const uint32_t value = selector;
+		error = rh_send_cmds(res, found.addr, 3u, &offset, &value, 1,
+		    RH_ARC_TIMEOUT_US, NULL);
+	}
+	if (error) {
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, level, &count, &after);
+	if (error) {
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise after=%#x expected=%u\n",
+	    res, after, selector);
+	if (after != selector) {
+		printf("SWEET RPMH: ARC %s raise readback mismatch; no retry, no GPUCC access\n", res);
+		error = EIO;
+	} else if (after >= count) {
+		printf("SWEET RPMH: ARC %s raise readback index outside table; no retry\n", res);
+		error = EIO;
+	} else {
+		printf("SWEET RPMH: ARC %s raise verified selector=%u vlvl=%u\n",
+		    res, selector, level[after]);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC raise %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/*
+ * 0149 opt-in (sweetsmmuprobe=1): vote SN15+CN0, then read the apps SMMU's
+ * ID registers from a thread of its own, logging before each read so a stall
+ * is visible as the last line. Votes stay in place for wland's SMMU step.
+ */
+/*
+ * 0180: read-only. Which SMRs route the display controller (MDSS, DT iommus
+ * SID 0x800 mask 0x440) and how its context bank translates, so a page-flip
+ * present knows whether scanout addresses are physical (bypass or SCTLR.M=0)
+ * or go through an ABL page table (TTBR0).
+ */
+#define SMMU_MDSS_SID   0x800u
+#define SMMU_MDSS_MASK  0x440u
+static void
+sweet_smmu_dump_mdss(volatile uint32_t *gr0, uint32_t id0, uint32_t id1)
+{
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	const uint64_t psize = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1ull << (((id1 >> 28) & 7) + 1);
+	if (psize != 0x1000 || nsmr > 128 || ncb > 128 || (npage + ncb) * psize > 0x100000) {
+		printf("SWEET SMMU: MDSS: unexpected geometry\n");
+		return;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(0x15000000 + psize, psize);
+	unsigned found = 0;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			continue;
+		}
+		const uint32_t id = smr & 0x7fff, m = (smr >> 16) & 0x7fff;
+		/* Overlaps the MDSS stream group: some SID matches both. */
+		if (((id ^ SMMU_MDSS_SID) & ~(m | SMMU_MDSS_MASK) & 0x7fff) != 0) {
+			continue;
+		}
+		found++;
+		const uint32_t type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		if (type != 0 || cb >= ncb || gr1 == NULL) {
+			printf("SWEET SMMU: MDSS SMR%u %#x S2CR %#x (type %u: %s)\n", i, smr, s2cr, type,
+			    type == 1 ? "bypass" : type == 2 ? "fault" : "translate");
+			continue;
+		}
+		volatile uint32_t *cbp = (volatile uint32_t *)ml_io_map(0x15000000 + (npage + cb) * psize, psize);
+		if (cbp == NULL) {
+			continue;
+		}
+		printf("SWEET SMMU: MDSS SMR%u %#x S2CR %#x -> CB%u CBAR %#x CBA2R %#x SCTLR %#x TTBR0 %#x%08x TCR %#x TCR2 %#x MAIR %#x,%#x FSR %#x FAR %#x%08x\n",
+		    i, smr, s2cr, cb, gr1[cb], gr1[(0x800 + 4 * cb) / 4], cbp[0], cbp[0x24 / 4], cbp[0x20 / 4],
+		    cbp[0x30 / 4], cbp[0x10 / 4], cbp[0x38 / 4], cbp[0x3c / 4], cbp[0x58 / 4], cbp[0x64 / 4], cbp[0x60 / 4]);
+	}
+	printf("SWEET SMMU: MDSS %#x/%#x: %u matching SMRs\n", SMMU_MDSS_SID, SMMU_MDSS_MASK, found);
+}
+
+static void
+sweet_smmu_probe_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	extern void IOSleep(unsigned);
+	const int votes = (int)(uintptr_t)arg;
+	IOSleep(1000);
+	printf("SWEET SMMU: votes %s; reading apps SMMU sCR0/ID0/ID1 next\n", votes ? "failed" : "held");
+	volatile uint32_t *smmu = (volatile uint32_t *)ml_io_map(0x15000000, 0x1000);
+	if (!smmu) {
+		printf("SWEET SMMU: map failed\n");
+		return;
+	}
+	const uint32_t scr0 = smmu[0];
+	printf("SWEET SMMU: sCR0=%#x\n", scr0);
+	const uint32_t id0 = smmu[0x20 / 4], id1 = smmu[0x24 / 4], id2 = smmu[0x28 / 4];
+	printf("SWEET SMMU: ID0=%#x ID1=%#x ID2=%#x: %u SMRs, %u context banks\n", id0, id1, id2, id0 & 0xff, id1 & 0xff);
+	sweet_smmu_dump_mdss(smmu, id0, id1);
+}
+
+void sweet_smmu_probe_start(void);
+void
+sweet_smmu_probe_start(void)
+{
+	int on = 0;
+	PE_parse_boot_argn("sweetsmmuprobe", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	/* 0150: vote now, in bsd init, so the path is up before launchd can start
+	 * wland (0139: the 20 s-later votes made the first apps-SMMU reads work). */
+	const int sn = sweet_rpmh_bcm_vote("SN15", 1, 1), cn = sweet_rpmh_bcm_vote("CN0", 1, 1);
+	printf("SWEET SMMU: votes SN15=%d CN0=%d\n", sn, cn);
+	thread_t thread = THREAD_NULL;
+	if (kernel_thread_start(sweet_smmu_probe_thread, (void *)(uintptr_t)(sn || cn), &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET SMMU: apps SMMU probe armed (1 s)\n");
+	}
+}
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 0169: memory bandwidth. Nothing here voted for DRAM; the frames stayed at ~300 Mpx/s of GPU fill
+ * whatever the GPU clock, tiling or shaders (0154-0158 hardware). HackiOS (oosexgang/hackios-xnu-kernel,
+ * bsd/dev/hakios.cpufreq.c ddr_raise(), Poco X5 Pro) casts what Linux's interconnect driver casts for a
+ * busy GPU: the memory controller's BCM (MC0) and the shared hub with the system cache (SH0) at the
+ * most there is (commit, valid, average and peak 14 bits each), and ACV with the apps bit (8): their
+ * Control Center 46 -> 59 frames/s, Settings opening 29 -> 37. sweetddr=0: no vote; sweetddrvote=N:
+ * N instead of 0x3fff.
+ */
+void sweet_rpmh_ddr_raise(void);
+void
+sweet_rpmh_ddr_raise(void)
+{
+	uint32_t on = 1, vote = 0x3fff;
+	PE_parse_boot_argn("sweetddr", &on, sizeof(on));
+	PE_parse_boot_argn("sweetddrvote", &vote, sizeof(vote));
+	if (!on || vote == 0 || vote > 0x3fff) {
+		printf("SWEET DDR: no memory bandwidth vote (sweetddr=%u, vote %u)\n", on, vote);
+		return;
+	}
+	const int mc0 = sweet_rpmh_bcm_vote("MC0", vote, vote);
+	const int sh0 = sweet_rpmh_bcm_vote("SH0", vote, vote);
+	const int acv = sweet_rpmh_bcm_vote("ACV", 0, 8);
+	printf("SWEET DDR: memory bandwidth vote %u: MC0 %d, SH0 %d, ACV %d\n", vote, mc0, sh0, acv);
+}
+#endif
