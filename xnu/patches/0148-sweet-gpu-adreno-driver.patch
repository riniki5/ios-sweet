-/*
- * 0146: the CP over the pool. The core's own SMMU bank shares the tables the
- * GMU's bank walks, so every pool offset is reachable at GMU_IOVA(off); the
- * GPU's kernel stream 0 is what Linux calls SID 0 in group 0.
- */
-static bool
-gpu_core_smmu_map(void)
-{
-	uint32_t bank, i, tlb;
-	bool ok;
-
-	if (!gpu_smmu || !gpu_pool) {
-		printf("SWEET GPU: core smmu: no window or pool\n");
-		return false;
-	}
-	bank = gpu_smmu_bank_base() + GPU_CORE_BANK * 0x1000u;
-	if ((uint64_t)bank + 0x1000u > 0x10000u) {
-		printf("SWEET GPU: core smmu: bank %u outside the window\n",
-		    GPU_CORE_BANK);
-		return false;
-	}
-	gpu_wr(gpu_smmu, SMMU_GR1_CBA2R(GPU_CORE_BANK), SMMU_CBA2R_VA64);
-	gpu_wr(gpu_smmu, SMMU_GR1_CBAR(GPU_CORE_BANK), SMMU_CBAR_S1);
-	gpu_wr(gpu_smmu, bank + SMMU_CB_TCR2, SMMU_TCR2_36BIT);
-	gpu_wr64(gpu_smmu, bank + SMMU_CB_TTBR0,
-	    (uint64_t)(gpu_pool_pa + GMU_POOL_L1));
-	gpu_wr(gpu_smmu, bank + SMMU_CB_TCR, SMMU_TCR_32BIT);
-	gpu_wr(gpu_smmu, bank + SMMU_CB_MAIR0, SMMU_MAIR0_VALUE);
-	gpu_wr(gpu_smmu, bank + SMMU_CB_MAIR1, 0);
-	gpu_wr(gpu_smmu, bank + SMMU_CB_FSR, ~0u);
-	gpu_wr(gpu_smmu, bank + SMMU_CB_SCTLR,
-	    SMMU_SCTLR_ON | SMMU_SCTLR_HUPCF);
-	gpu_wr(gpu_smmu, SMMU_GR0_S2CR + 4u * GPU_CORE_GROUP, GPU_CORE_BANK);
-	gpu_wr(gpu_smmu, SMMU_GR0_SMR + 4u * GPU_CORE_GROUP,
-	    SMMU_SMR_VALID | GPU_CORE_SID);
-	gpu_wr(gpu_smmu, SMMU_TLBIALLNSNH, 0);
-	gpu_wr(gpu_smmu, SMMU_TLBGSYNC, 0);
-	for (i = 1; i <= 200; ++i) {
-		if (!(gpu_rd(gpu_smmu, SMMU_TLBGSTATUS) & 1u)) {
-			break;
-		}
-		delay(100);
-	}
-	tlb = i <= 200u;
-	printf("SWEET GPU: core smmu bank=%u cbar=%#x sctlr=%#x ttbr0=%#llx"
-	    " smr=%#x s2cr=%#x tlb=%u\n", GPU_CORE_BANK,
-	    gpu_rd(gpu_smmu, SMMU_GR1_CBAR(GPU_CORE_BANK)),
-	    gpu_rd(gpu_smmu, bank + SMMU_CB_SCTLR),
-	    (unsigned long long)gpu_rd64(gpu_smmu, bank + SMMU_CB_TTBR0),
-	    gpu_rd(gpu_smmu, SMMU_GR0_SMR + 4u * GPU_CORE_GROUP),
-	    gpu_rd(gpu_smmu, SMMU_GR0_S2CR + 4u * GPU_CORE_GROUP), tlb);
-	(void)sweet_log_sync();
-	ok = tlb;
-	ok &= gpu_smmu_probe(bank, GMU_IOVA(GMU_POOL_RING),
-	    gpu_pool_pa + GMU_POOL_RING, TRUE);
-	ok &= gpu_smmu_probe(bank, GMU_IOVA(GMU_POOL_SQE),
-	    gpu_pool_pa + GMU_POOL_SQE, TRUE);
-	gpu_wr(gpu_smmu, bank + SMMU_CB_FSR,
-	    gpu_rd(gpu_smmu, bank + SMMU_CB_FSR));
-	printf("SWEET GPU: core smmu %s fsr=%#x\n", ok ? "verified" :
-	    "NOT VERIFIED", gpu_rd(gpu_smmu, bank + SMMU_CB_FSR));
-	(void)sweet_log_sync();
-	return ok;
-}
-
-static bool
-gpu_core_sqe_load(void)
-{
-	unsigned i, n = sizeof(gpu_a630_sqe) / sizeof(gpu_a630_sqe[0]);
-
-	if (n * 4u > GMU_POOL_SQE_BYTES) {
-		printf("SWEET GPU: core sqe: %u words do not fit\n", n);
-		return false;
-	}
-	for (i = 0; i < n; ++i) {
-		gpu_pool_wr(GMU_POOL_SQE + i * 4u, gpu_a630_sqe[i]);
-	}
-	for (i = 0; i < n; ++i) {
-		if (gpu_pool_rd(GMU_POOL_SQE + i * 4u) != gpu_a630_sqe[i]) {
-			break;
-		}
-	}
-	printf("SWEET GPU: core sqe words=%u ver=%#x va=%#x readback=%s\n", n,
-	    gpu_pool_rd(GMU_POOL_SQE + 4u), GMU_IOVA(GMU_POOL_SQE),
-	    i == n ? "ok" : "MISMATCH");
-	(void)sweet_log_sync();
-	return i == n;
-}
-
-/* The OOB the reference sends before GPU_SET; here the GPU is already set. */
-static uint32_t
-gpu_core_dcvs(uint32_t level)
-{
-	uint32_t i, v = 0;
-
-	gpu_wr(gpu_gmu, GMU_DCVS_ACK_OPTION, 0);
-	gpu_wr(gpu_gmu, GMU_DCVS_PERF_SETTING, (3u << 28) | (level & 0xfu));
-	gpu_wr(gpu_gmu, GMU_DCVS_BW_SETTING, 0xffu);
-	gpu_wr(gpu_gmu, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_DCVS_SET);
-	for (i = 1; i <= 500; ++i) {
-		v = gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO);
-		if (v & (1u << GMU_OOB_DCVS_ACK)) {
-			break;
-		}
-		delay(100);
-	}
-	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_CLR, 1u << GMU_OOB_DCVS_ACK);
-	gpu_wr(gpu_gmu, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_DCVS_ACK);
-	printf("SWEET GPU: core dcvs level=%u polls=%u ret=%#x intr=%#x\n",
-	    level, i <= 500u ? i : 0u, gpu_rd(gpu_gmu, GMU_DCVS_RETURN), v);
-	(void)sweet_log_sync();
-	return i <= 500u ? i : 0u;
-}
-
-static uint32_t
-gpu_pm4_type7(uint32_t opcode, uint32_t count)
-{
-	uint32_t c = count ^ (count >> 4) ^ (count >> 8) ^ (count >> 12) ^
-	    (count >> 16) ^ (count >> 20) ^ (count >> 24) ^ (count >> 28);
-	uint32_t o = opcode ^ (opcode >> 4) ^ (opcode >> 8) ^ (opcode >> 12) ^
-	    (opcode >> 16) ^ (opcode >> 20) ^ (opcode >> 24) ^ (opcode >> 28);
-
-	return 0x70000000u | count | (((0x9669u >> (0xfu & c)) & 1u) << 15) |
-	    (opcode << 16) | (((0x9669u >> (0xfu & o)) & 1u) << 23);
-}
-
-static uint32_t gpu_ring_wptr;
-
-static void
-gpu_ring_push(uint32_t word)
-{
-	gpu_pool_wr(GMU_POOL_RING + gpu_ring_wptr * 4u, word);
-	gpu_ring_wptr = (gpu_ring_wptr + 1u) % (GMU_POOL_RING_BYTES / 4u);
-}
-
-/* a6xx_flush: ask the CP to report where it is, then hand it the write
- * pointer; the firmware here has NO_UPDATE set, so WHERE_AM_I is the only
- * read pointer the host sees advance. */
-static void
-gpu_ring_flush(void)
-{
-	uint64_t va = GMU_IOVA(GPU_MISC_SHADOW);
-
-	gpu_ring_push(gpu_pm4_type7(PM4_WHERE_AM_I, 2));
-	gpu_ring_push((uint32_t)va);
-	gpu_ring_push((uint32_t)(va >> 32));
-	gpu_wr(gpu_core, CORE_CP_RB_WPTR, gpu_ring_wptr);
-}
-
-static uint32_t
-gpu_core_poll(uint32_t reg, uint32_t mask, uint32_t want)
-{
-	uint32_t i;
-
-	for (i = 1; i <= 1000; ++i) {
-		if ((gpu_rd(gpu_core, reg) & mask) == want) {
-			return i;
-		}
-		delay(100);
-	}
-	return 0;
-}
-
-static uint32_t
-gpu_pool_poll(uint32_t off, uint32_t want)
-{
-	uint32_t i;
-
-	for (i = 1; i <= 1000; ++i) {
-		if (gpu_pool_rd(off) == want) {
-			return i;
-		}
-		delay(100);
-	}
-	return 0;
-}
