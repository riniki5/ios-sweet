-static bool
-gpu_rsc_start(void)
-{
-	unsigned i, j;
-
-	gpu_wr(gpu_gmu, GMU_RSCC_CONTROL_REQ, 2);
-	for (i = 1; i <= 1000; ++i) {
-		if ((gpu_rd(gpu_gmu, GMU_RSCC_CONTROL_ACK) & 2u) == 2u) {
-			break;
