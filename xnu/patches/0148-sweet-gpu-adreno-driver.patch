-static void
-gpu_pool_entry(uint32_t table, uint32_t index, uint64_t value)
-{
-	gpu_pool_wr(table + index * 8u, (uint32_t)value);
-	gpu_pool_wr(table + index * 8u + 4u, (uint32_t)(value >> 32));
