-static void
-gpu_hfi_queue(uint32_t header, uint32_t iova, uint32_t id)
-{
-	gpu_pool_wr(header, 1);                 /* status */
-	gpu_pool_wr(header + 4, iova);
-	gpu_pool_wr(header + 8, (10u << 8) | id);
-	gpu_pool_wr(header + 12, HFI_QUEUE_WORDS);
-	gpu_pool_wr(header + 24, 1);            /* rx watermark */
-	gpu_pool_wr(header + 28, 1);            /* tx watermark */
-	gpu_pool_wr(header + 32, 1);            /* rx request */
-}
-
-static void
-gpu_hfi_table(void)
-{
-	gpu_pool_wr(GMU_POOL_HFI, 0);
-	gpu_pool_wr(GMU_POOL_HFI + 4, 24 + 2 * 48);
-	gpu_pool_wr(GMU_POOL_HFI + 8, 24 >> 2);
-	gpu_pool_wr(GMU_POOL_HFI + 12, 48 >> 2);
-	gpu_pool_wr(GMU_POOL_HFI + 16, 2);
-	gpu_pool_wr(GMU_POOL_HFI + 20, 2);
-	/* With bypass the IOVA the firmware sees is the pool's physical
-	 * address: command id 0, response id 4, one 4 KiB queue each. */
-	gpu_hfi_queue(HFI_CMD_HEADER, GMU_IOVA(HFI_CMD_DATA), 0);
-	gpu_hfi_queue(HFI_RSP_HEADER, GMU_IOVA(HFI_RSP_DATA), 4);
-}
-
-/*
- * One HFI message and its acknowledgement, a6xx_hfi.c legacy wire format: the
- * message goes into the command queue, whose read/write indices live at +40
- * and +44 of the queue header, and the doorbell is host2gmu bit 0.
- */
-static bool
-gpu_hfi_send(uint32_t id, uint32_t *msg, uint32_t dwords)
-{
-	static uint32_t seq;
-	uint32_t at, i, read, size, response[24];
-	bool acked = false;
-
-	msg[0] = ((++seq << 20) | (dwords << 8) | id);
-	at = gpu_pool_rd(HFI_CMD_HEADER + HFI_WRITE_INDEX);
-	for (i = 0; i < dwords; ++i) {
-		gpu_pool_wr(HFI_CMD_DATA + at * 4u, msg[i]);
-		at = (at + 1u) % HFI_QUEUE_WORDS;
-	}
-	gpu_pool_wr(HFI_CMD_HEADER + HFI_WRITE_INDEX, at);
-	gpu_wr(gpu_gmu, GMU_HOST2GMU_INTR_SET, 1u);
-	for (i = 1; i <= 3000; ++i) {
-		if (gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO) & 1u) {
-			break;
-		}
-		delay(100);
-	}
-	printf("SWEET GPU: hfi msg %u polls=%u info=%#x\n", id, i,
-	    gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO));
-	(void)sweet_log_sync();
-	if (i > 3000) {
-		return false;
-	}
-	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_CLR, 1u);
-	for (unsigned tries = 0; tries < 8 && !acked; ++tries) {
-		read = gpu_pool_rd(HFI_RSP_HEADER + HFI_READ_INDEX);
-		if (read == gpu_pool_rd(HFI_RSP_HEADER + HFI_WRITE_INDEX) ||
-		    read >= HFI_QUEUE_WORDS) {
-			break;
-		}
-		size = (gpu_pool_rd(HFI_RSP_DATA + read * 4u) >> 8) & 0xffu;
-		if (!size || size > sizeof(response) / sizeof(response[0])) {
-			printf("SWEET GPU: hfi msg %u answer size %u\n", id, size);
-			break;
-		}
-		for (i = 0; i < size; ++i) {
-			response[i] = gpu_pool_rd(HFI_RSP_DATA + read * 4u);
-			read = (read + 1u) % HFI_QUEUE_WORDS;
-		}
-		gpu_pool_wr(HFI_RSP_HEADER + HFI_READ_INDEX, read);
-		if ((response[0] & 0xffu) == HFI_MSG_ERROR) {
-			printf("SWEET GPU: hfi fw error %#x for msg %u\n",
-			    size > 1 ? response[1] : 0u, id);
-			continue;
-		}
-		if (((response[1] >> 20) & 0xfffu) != seq) {
-			continue;
-		}
-		printf("SWEET GPU: hfi msg %u ack status=%u payload=%#x\n", id,
-		    response[2], response[3]);
-		(void)sweet_log_sync();
-		acked = response[2] == 0;
-	}
-	return acked;
-}
-
-/*
- * The PERF_TABLE the firmware gets: toco's GPU OPP table (stock boot.dtb,
- * speed bin 0) against the cmd-db level maps log85 read -- gfx.lvl
- * 0,16,64,128,192,256,320,384,416; mx.lvl 0,16,192,320,384; cx.lvl
- * 0,16,64,128,192,256,384. A vote is level<<16 | mx index<<8 | rail index,
- * a6xx_gmu_rpmh_arc_votes_init's encoding, and the same word
- * GMU_GX_VOTE_IDX/GMU_MX_VOTE_IDX take in its low bytes.
- */
-#define GMU_LEVELS_GX           9u
-#define GMU_LEVELS_CX           2u
-static const uint32_t gpu_gx_khz[GMU_LEVELS_GX] = { 0, 180000, 267000,
-    355000, 430000, 565000, 650000, 800000, 825000 };
-static const uint32_t gpu_gx_level[GMU_LEVELS_GX] = { 0, 16, 64, 128, 192,
-    256, 320, 384, 416 };
-static const uint32_t gpu_cx_khz[GMU_LEVELS_CX] = { 0, 200000 };
-static const uint32_t gpu_cx_level[GMU_LEVELS_CX] = { 0, 48 };
-static const uint32_t gpu_gfx_db[] = { 0, 16, 64, 128, 192, 256, 320, 384, 416 };
-static const uint32_t gpu_mx_db[] = { 0, 16, 192, 320, 384 };
-static const uint32_t gpu_cx_db[] = { 0, 16, 64, 128, 192, 256, 384 };
-
-static bool
-gpu_arc_vote(const uint32_t *pri, unsigned pri_count, const uint32_t *sec,
-    unsigned sec_count, uint32_t level, uint32_t *vote)
-{
-	unsigned pindex = pri_count, sindex = 0, j;
-
-	for (j = 0; j < pri_count; ++j) {
-		if (pri[j] >= level) {
-			pindex = j;
-			break;
-		}
-	}
-	if (pindex == pri_count) {
-		return false;
-	}
-	for (j = 0; j < sec_count; ++j) {
-		if (sec[j] >= level) {
-			sindex = j;
-			break;
-		}
-		if (sec[j]) {
-			sindex = j;
-		}
-	}
-	*vote = (pri[pindex] << 16) | (sindex << 8) | pindex;
-	return true;
-}
-
-static bool
-gpu_hfi_perf_table(uint32_t *perf)
-{
-	uint32_t vote;
-	unsigned i;
-
-	bzero(perf, HFI_PERF_DWORDS * 4u);
-	perf[1] = GMU_LEVELS_GX;
-	perf[2] = GMU_LEVELS_CX;
-	for (i = 0; i < GMU_LEVELS_GX; ++i) {
-		if (!gpu_arc_vote(gpu_gfx_db, sizeof(gpu_gfx_db) / sizeof(gpu_gfx_db[0]),
-		    gpu_mx_db, sizeof(gpu_mx_db) / sizeof(gpu_mx_db[0]),
-		    gpu_gx_level[i], &vote)) {
-			printf("SWEET GPU: hfi perf: GX level %u missing from cmd-db\n",
-			    gpu_gx_level[i]);
-			return false;
-		}
-		perf[3 + 2 * i] = vote;
-		perf[4 + 2 * i] = gpu_gx_khz[i];
-	}
-	for (i = 0; i < GMU_LEVELS_CX; ++i) {
-		if (!gpu_arc_vote(gpu_cx_db, sizeof(gpu_cx_db) / sizeof(gpu_cx_db[0]),
-		    gpu_mx_db, sizeof(gpu_mx_db) / sizeof(gpu_mx_db[0]),
-		    gpu_cx_level[i], &vote)) {
-			printf("SWEET GPU: hfi perf: CX level %u missing from cmd-db\n",
-			    gpu_cx_level[i]);
-			return false;
-		}
-		perf[35 + 2 * i] = vote;
-		perf[36 + 2 * i] = gpu_cx_khz[i];
-	}
-	printf("SWEET GPU: hfi perf gx_top=%#x cx_top=%#x\n",
-	    perf[3 + 2 * (GMU_LEVELS_GX - 1u)], perf[35 + 2 * (GMU_LEVELS_CX - 1u)]);
-	return true;
-}
-
-/*
- * BW_TABLE for a GMU that does no bus scaling: one bandwidth level, one CNOC
- * command and three DDR ones, all fixed votes (a6xx_hfi_send_bw_table).
- */
-static void
-gpu_hfi_bw_table(uint32_t *bw)
-{
-	bzero(bw, HFI_BW_DWORDS * 4u);
-	bw[1] = 1;             /* bandwidth levels */
-	bw[2] = 1;             /* CNOC commands */
-	bw[3] = 3;             /* DDR commands */
-	bw[4] = 1;             /* CNOC wait bitmask */
-	bw[5] = 1;             /* DDR wait bitmask */
-	bw[6] = 0x5007cu;      /* CNOC address */
-	bw[12] = 0x40000000u;  /* CNOC data */
-	bw[18] = 0x60000001u;
-	bw[24] = 0x50000u;     /* DDR addresses */
-	bw[25] = 0x5003cu;
-	bw[26] = 0x5000cu;
-	bw[32] = bw[33] = bw[34] = 0x40000000u;
-}
-
-/*
- * The handshake a6xx_gmu_resume runs once FW_INIT_RESULT is in: tell the CM3
- * which rail entries to vote, let it boot GX and acknowledge, power SPTPRAC,
- * start the HFI queues, then hand the firmware its tables, an address space
- * and a version.
- */
-static bool
-gpu_gmu_hfi_start(void)
-{
-	uint32_t v = 0, i;
-	uint32_t init[5] = { 0, 0, GMU_IOVA(GMU_POOL_DEBUG),
-	    GMU_DEBUG_BYTES, 1 };
-	uint32_t version[2] = { 0, (1u << 28) | (1u << 19) | (1u << 17) };
-	uint32_t perf[HFI_PERF_DWORDS], bw[HFI_BW_DWORDS], test[1] = { 0 };
-
-	printf("SWEET GPU: hfi begin t=%llu\n", gpu_uptime_ms());
-	(void)sweet_log_sync();
-	gpu_wr(gpu_gmu, GMU_BOOT_SLUMBER_OPTION, 0);
-	gpu_wr(gpu_gmu, GMU_GX_VOTE_IDX, GMU_GX_VOTE_TOP);
-	gpu_wr(gpu_gmu, GMU_MX_VOTE_IDX, GMU_MX_VOTE_TOP);
-	gpu_wr(gpu_gmu, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_BOOT_SET);
-	for (i = 1; i <= 10000; ++i) {
-		v = gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO);
-		if (v & (1u << GMU_OOB_BOOT_ACK)) {
-			break;
-		}
-		delay(100);
-	}
-	printf("SWEET GPU: hfi boot oob polls=%u info=%#x\n", i, v);
-	(void)sweet_log_sync();
-	if (i > 10000) {
-		return false;
-	}
-	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_CLR, 1u << GMU_OOB_BOOT_ACK);
-	gpu_sptprac_on();
-	gpu_smmu_fault("pre-hfi");
-	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_CLR, 0xffffffffu);
-	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_MASK, 0xffffffffu);
-	gpu_smmu_gmu_state("pre-hfi");
-	/* Reads of the GMU block were still landing after SPTPRAC in 0137/0138,
-	 * so this is the last state before the one store that has wedged twice. */
-	printf("SWEET GPU: hfi pre init=%#x status=%#x ao=%#x fence-ctl=%#x"
-	    " fence=%#x mask=%#x\n",
-	    gpu_rd(gpu_gmu, GMU_HFI_CTRL_INIT),
-	    gpu_rd(gpu_gmu, GMU_HFI_CTRL_STATUS), gpu_gmu_ao_counter(),
-	    gpu_rd(gpu_gmu, GMU_AO_AHB_FENCE_CTRL),
-	    gpu_rd(gpu_gmu, GMU_AHB_FENCE_STATUS),
-	    gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_MASK));
-	(void)sweet_log_sync();
-	/*
-	 * 0140's init-store test proved the store itself works while the CM3
-	 * is held, and 0140's boot then hung on the very same store after
-	 * SPTPRAC. Write registers that carry no meaning here before the real
-	 * store: if these land, the GMU's register window is still taking AP
-	 * writes and the hang is the firmware's reaction to CTRL_INIT; if they
-	 * hang, the window is dead before HFI is touched.
-	 */
-	if (gpu_hfi_pre) {
-		printf("SWEET GPU: hfi pre-set, only reading status\n");
-		(void)sweet_log_sync();
-	} else {
-		printf("SWEET GPU: hfi probe writes begin\n");
-		(void)sweet_log_sync();
-		gpu_wr(gpu_gmu, GMU_GENERAL_7, gpu_rd(gpu_gmu, GMU_GENERAL_7));
-		printf("SWEET GPU: hfi probe general7 done reads %#x\n",
