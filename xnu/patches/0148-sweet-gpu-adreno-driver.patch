-/*
- * What stream the GMU uses on toco is not in the vendor device tree, so a
- * stage-1 bank cannot be built from evidence yet. Bypass is the part of the
- * SMMU setup that needs no stream id: unmatched streams stop faulting and every
- * stream the bootloader matched is switched to bypass as well. The inventory
- * printed here is what a later patch needs to build the real mapping.
- */
-static void
-gpu_smmu_bypass(void)
-{
-	uint32_t idr0, idr1, scr0;
-	unsigned groups, valid = 0, shown = 0, n;
-
-	if (!gpu_smmu) {
-		printf("SWEET GPU: full smmu not mapped, no bypass\n");
-		return;
-	}
-	idr0 = gpu_rd(gpu_smmu, SMMU_GR0_IDR0);
-	idr1 = gpu_rd(gpu_smmu, SMMU_GR0_IDR1);
-	scr0 = gpu_rd(gpu_smmu, SMMU_GR0_SCR0);
-
-	printf("SWEET GPU: full smmu idr0=%#x idr1=%#x scr0=%#x scr1=%#x"
-	    " acr=%#x gbpa=%#x sgfsr=%#x\n", idr0, idr1, scr0,
-	    gpu_rd(gpu_smmu, 0x4), gpu_rd(gpu_smmu, 0x10),
-	    gpu_rd(gpu_smmu, 0x44), gpu_rd(gpu_smmu, SMMU_GR0_SGFSR));
-	gpu_pause(300);
-	if (idr0 == ~0u || idr1 == ~0u) {
-		printf("SWEET GPU: full smmu not answering, not touched\n");
-		return;
-	}
-	groups = idr0 & 0xffu;
-	if (groups > 64) {
-		groups = 64;
-	}
-	for (n = 0; n < groups; ++n) {
-		uint32_t smr = gpu_rd(gpu_smmu, SMMU_GR0_SMR + 4 * n);
-
-		if (!(smr & SMMU_SMR_VALID)) {
-			continue;
-		}
-		valid++;
-		if (shown++ < 8) {
-			uint32_t s2cr = gpu_rd(gpu_smmu, SMMU_GR0_S2CR + 4 * n);
-
-			printf("SWEET GPU: full smmu smr%u=%#x s2cr%u=%#x"
-			    " type=%u cb=%u\n", n, smr, n, s2cr,
-			    (s2cr >> 16) & 3u, s2cr & 0xffu);
-		}
-	}
-	printf("SWEET GPU: full smmu %u valid streams of %u groups\n", valid,
-	    idr0 & 0xffu);
-	gpu_pause(300);
-	if (scr0 & SMMU_SCR0_CLIENTPD) {
-		printf("SWEET GPU: full smmu client port disabled, not touched\n");
-		return;
-	}
-	if (scr0 & SMMU_SCR0_USFCFG) {
-		gpu_wr(gpu_smmu, SMMU_GR0_SCR0, scr0 & ~SMMU_SCR0_USFCFG);
-	}
-	for (n = 0; n < groups; ++n) {
-		uint32_t s2cr;
-
-		if (!(gpu_rd(gpu_smmu, SMMU_GR0_SMR + 4 * n) & SMMU_SMR_VALID)) {
-			continue;
-		}
-		s2cr = gpu_rd(gpu_smmu, SMMU_GR0_S2CR + 4 * n);
-		if ((s2cr & SMMU_S2CR_TYPE) != SMMU_S2CR_BYPASS) {
-			gpu_wr(gpu_smmu, SMMU_GR0_S2CR + 4 * n,
-			    (s2cr & ~SMMU_S2CR_TYPE) | SMMU_S2CR_BYPASS);
-		}
-	}
-	printf("SWEET GPU: full smmu bypass scr0=%#x gbpa=%#x sgfsr=%#x\n",
-	    gpu_rd(gpu_smmu, SMMU_GR0_SCR0), gpu_rd(gpu_smmu, 0x44),
-	    gpu_rd(gpu_smmu, SMMU_GR0_SGFSR));
-	gpu_pause(300);
-}
