-/*
- * 0145: the GX core. Everything above configures the CM3; the sequence below is
- * a6xx_start's register part without the SQE load, which needs the core's own
- * SMMU mapping. a6xx_reg.h offsets are dwords and gpu_wr()/gpu_rd() take bytes,
- * so every constant is the header value times four.
- */
-#define CORE_RBBM_STATUS        0x0840u
-#define CORE_RBBM_STATUS3       0x084cu
-#define CORE_RBBM_CLOCK_CNTL    0x02b8u
-#define CORE_PERFCTR_BUSY_MASK  0x142cu
-#define CORE_PERFCTR_CNTL       0x1400u
-#define CORE_UCHE_RANGE_MAX_LO  0x3814u
