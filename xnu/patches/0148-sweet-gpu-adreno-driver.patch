-	}
-	gpu_hfi_bw_table(bw);
-	if (!gpu_hfi_send(HFI_MSG_BW_TABLE, bw, HFI_BW_DWORDS)) {
-		printf("SWEET GPU: hfi: no bw table ack\n");
