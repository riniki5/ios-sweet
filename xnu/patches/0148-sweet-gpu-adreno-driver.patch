-
-static void
-gpu_core_cp(void)
-{
-	uint32_t i, init_polls, idle_polls, ring_polls, ib_polls, fence_polls;
-	uint64_t va;
-
-	gpu_ring_wptr = 0;
-	for (i = 0; i < GMU_POOL_RING_BYTES; i += 4u) {
-		gpu_pool_wr(GMU_POOL_RING + i, 0);
-	}
-	for (i = 0; i < 0x400u; i += 4u) {
-		gpu_pool_wr(GMU_POOL_MISC + i, 0);
-	}
-	printf("SWEET GPU: core cp begin t=%llu\n", gpu_uptime_ms());
-	(void)sweet_log_sync();
-	if (!gpu_core_smmu_map() || !gpu_core_sqe_load()) {
-		printf("SWEET GPU: core cp: mapping or SQE did not land\n");
-		(void)sweet_log_sync();
-		return;
-	}
-	gpu_core_dcvs(CORE_PERF_LOWEST);
-	for (i = 0; i < sizeof(gpu_a615_addr_modes) /
-	    sizeof(gpu_a615_addr_modes[0]); ++i) {
-		gpu_wr(gpu_core, gpu_a615_addr_modes[i], 1u);
-	}
-	gpu_wr(gpu_core, CORE_CP_PERFCTR_CP_SEL0, 0);
-	va = GMU_IOVA(GMU_POOL_SQE);
-	gpu_wr64(gpu_core, CORE_CP_SQE_INSTR_BASE, va);
-	va = GMU_IOVA(GMU_POOL_RING);
-	gpu_wr64(gpu_core, CORE_CP_RB_BASE, va);
-	gpu_wr(gpu_core, CORE_CP_RB_CNTL, CORE_RB_CNTL_DEFAULT);
-	va = GMU_IOVA(GPU_MISC_SHADOW);
-	gpu_wr64(gpu_core, CORE_CP_RB_RPTR_ADDR, va);
-	gpu_wr(gpu_core, CORE_CP_SQE_CNTL, 1u);
-	printf("SWEET GPU: core cp started rb=%#x cntl=%#x sqe-instr=%#llx"
-	    " rptr-addr=%#llx\n", gpu_rd(gpu_core, CORE_CP_RB_BASE),
-	    gpu_rd(gpu_core, CORE_CP_RB_CNTL),
-	    (unsigned long long)gpu_rd64(gpu_core, CORE_CP_SQE_INSTR_BASE),
-	    (unsigned long long)gpu_rd64(gpu_core, CORE_CP_RB_RPTR_ADDR));
-	(void)sweet_log_sync();
-	/* ME_INIT: multiple contexts, error detect, no header dump. */
-	gpu_ring_push(gpu_pm4_type7(PM4_ME_INIT, 8));
-	gpu_ring_push(0x2fu);
-	gpu_ring_push(0x3u);
-	gpu_ring_push(0x20000000u);
-	for (i = 0; i < 5; ++i) {
-		gpu_ring_push(0);
-	}
-	gpu_ring_flush();
-	init_polls = gpu_core_poll(CORE_CP_RB_RPTR, ~0u, gpu_ring_wptr);
-	idle_polls = gpu_core_poll(CORE_RBBM_STATUS, ~1u, 0);
-	printf("SWEET GPU: core me-init rptr-polls=%u idle-polls=%u wptr=%u"
-	    " rptr=%#x rbbm=%#x t=%llu\n", init_polls, idle_polls,
-	    gpu_ring_wptr, gpu_rd(gpu_core, CORE_CP_RB_RPTR),
-	    gpu_rd(gpu_core, CORE_RBBM_STATUS), gpu_uptime_ms());
-	(void)sweet_log_sync();
-	if (!init_polls || !idle_polls) {
-		gpu_core_state("after me-init");
-		return;
-	}
-	/* One memory write from the ring itself. */
-	gpu_ring_push(gpu_pm4_type7(PM4_MEM_WRITE, 3));
-	va = GMU_IOVA(GPU_MISC_RESULT_RING);
-	gpu_ring_push((uint32_t)va);
-	gpu_ring_push((uint32_t)(va >> 32));
-	gpu_ring_push(GPU_RING_VALUE);
-	gpu_ring_flush();
-	ring_polls = gpu_pool_poll(GPU_MISC_RESULT_RING, GPU_RING_VALUE);
-	printf("SWEET GPU: core ring write polls=%u value=%#x\n", ring_polls,
-	    gpu_pool_rd(GPU_MISC_RESULT_RING));
-	(void)sweet_log_sync();
-	/* The same from an indirect buffer, then a timestamp fence. */
-	gpu_pool_wr(GPU_MISC_IB, gpu_pm4_type7(PM4_MEM_WRITE, 3));
-	va = GMU_IOVA(GPU_MISC_RESULT_IB);
-	gpu_pool_wr(GPU_MISC_IB + 4u, (uint32_t)va);
