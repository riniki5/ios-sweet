-	    " ttbr0=%#llx sctlr=%#x smr=%#x s2cr=%#x\n", GMU_IOVA_BASE,
-	    gpu_pool_pa, pages, gpu_rd(gpu_smmu, SMMU_GR1_CBAR(GMU_SMMU_BANK)),
