-static void
-gpu_core_state(const char *why)
-{
-	uint32_t bank = gpu_smmu_bank_base() + GPU_CORE_BANK * 0x1000u;
-
-	printf("SWEET GPU: core state %s rbbm=%#x int0=%#x fault=%#x irq=%#x"
-	    " protect=%#x rptr=%#x wptr=%#x sqe-cntl=%#x fsr=%#x fsynr0=%#x"
-	    " far=%#llx\n", why, gpu_rd(gpu_core, CORE_RBBM_STATUS),
-	    gpu_rd(gpu_core, CORE_RBBM_INT_0_STATUS),
-	    gpu_rd(gpu_core, CORE_CP_HW_FAULT),
-	    gpu_rd(gpu_core, CORE_CP_INTERRUPT_STATUS),
-	    gpu_rd(gpu_core, CORE_CP_PROTECT_STATUS),
-	    gpu_rd(gpu_core, CORE_CP_RB_RPTR),
-	    gpu_rd(gpu_core, CORE_CP_RB_WPTR),
-	    gpu_rd(gpu_core, CORE_CP_SQE_CNTL),
-	    gpu_smmu ? gpu_rd(gpu_smmu, bank + SMMU_CB_FSR) : 0,
-	    gpu_smmu ? gpu_rd(gpu_smmu, bank + SMMU_CB_FSYNR0) : 0,
-	    gpu_smmu ? (unsigned long long)gpu_rd64(gpu_smmu,
-	    bank + SMMU_CB_FAR) : 0ull);
