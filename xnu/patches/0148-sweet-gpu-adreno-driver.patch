-/*
- * 0147: the shader/GMEM path.  0145/0146 got the core register stage, the
- * shader cores (HWCG + SPTPRAC) and the CP running: the ring, SQE and
- * ME_INIT land and the CP goes idle.  What is missing is draws reaching the
- * cores.  The adreno 6xx draw path is PM4 packets on the CP ring (the CP
- * firmware fetches them): SELECT_CP_STATE, the dispatch packet; the CP
- * reports progress in the pool.  Poll the CP: it should consume the ring
- * and report no fault.  Run from gpu_gmu_full_boot(); boot arg
- * gpu_dispatch=1 gates the first submit.  Verify PM4_DISPATCH against the
- * vendor adreno_pm4.xml on the first boot.
- */
-#define PM4_SELECT_CP_STATE    0x06u
-#define PM4_DISPATCH          0x8au
