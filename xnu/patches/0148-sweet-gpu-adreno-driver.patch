-	ok &= gpu_smmu_probe(bank, GMU_IOVA_BASE,
-	    gpu_pool_pa, TRUE);
-	ok &= gpu_smmu_probe(bank, GMU_IOVA(GMU_POOL_LOG),
-	    gpu_pool_pa + GMU_POOL_LOG, TRUE);
-	ok &= gpu_smmu_probe(bank, GMU_IOVA(GMU_POOL_HFI),
-	    gpu_pool_pa + GMU_POOL_HFI, TRUE);
-	ok &= gpu_smmu_probe(bank, GMU_IOVA(GMU_POOL_DEBUG),
-	    gpu_pool_pa + GMU_POOL_DEBUG, TRUE);
-	ok &= gpu_smmu_probe(bank, GMU_IOVA(pages * 0x1000u - 0x1000u),
-	    gpu_pool_pa + pages * 0x1000u - 0x1000u, TRUE);
-	ok &= gpu_smmu_probe(bank, GMU_IOVA_BASE + 0x400000u, 0, FALSE);
-	ok &= gpu_smmu_probe(bank, 0x20000000u, 0, FALSE);
-	/* The CM3 should start from a clean bank. */
-	gpu_wr(gpu_smmu, bank + SMMU_CB_FSR,
-	    gpu_rd(gpu_smmu, bank + SMMU_CB_FSR));
-	gpu_wr(gpu_smmu, SMMU_GR0_SGFSR, gpu_rd(gpu_smmu, SMMU_GR0_SGFSR));
-	printf("SWEET GPU: smmu map %s sgfsr=%#x gfsynr0=%#x fsr=%#x\n",
-	    ok ? "verified" : "NOT VERIFIED", gpu_rd(gpu_smmu, SMMU_GR0_SGFSR),
-	    gpu_rd(gpu_smmu, SMMU_GR0_GFSYNR0),
-	    gpu_rd(gpu_smmu, bank + SMMU_CB_FSR));
-	(void)sweet_log_sync();
-	return ok;
-}
