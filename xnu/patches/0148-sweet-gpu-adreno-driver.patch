-	if (!gpu_hfi_send(HFI_MSG_TEST, test, 1)) {
-		printf("SWEET GPU: hfi: no test ack\n");
-		return false;
-	}
-	gpu_wr(gpu_gmu, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_GPU_SET);
-	for (i = 1; i <= 10000; ++i) {
-		v = gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO);
-		if (v & (1u << GMU_OOB_GPU_ACK)) {
-			break;
-		}
-		delay(100);
-	}
-	printf("SWEET GPU: hfi gpu oob polls=%u info=%#x\n", i, v);
-	if (i <= 10000) {
-		printf("SWEET GPU: hfi done power=%#x sptprac=%#x gx=%#x cx=%#x\n",
-		    gpu_rd(gpu_gmu, GMU_RPMH_POWER_STATE),
-		    gpu_rd(gpu_gmu, GMU_SPTPRAC_PWR_STATUS),
-		    gpu_rd(gpu_cc, GPUCC_GX_GDSCR),
-		    gpu_rd(gpu_cc, GPUCC_CX_GDSCR));
-	}
-	(void)sweet_log_sync();
-	if (i > 10000) {
-		return false;
-	}
-	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_CLR, 1u << GMU_OOB_GPU_ACK);
-	return true;
-}
