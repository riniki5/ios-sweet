-/* Where ARM_SMMU_CB(0) sits: NUMPAGENDXB register pages of 4 KiB. */
-static uint32_t
-gpu_smmu_bank_base(void)
-{
-	uint32_t idr1 = gpu_rd(gpu_smmu, SMMU_GR0_IDR1);
-	uint32_t page = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
-
-	return (2u << ((idr1 >> 28) & 7u)) * page;
-}
-
-/* ATS1PR: 1 when the walk finished; the PAR's FAULT bit and PA in *par. */
-static bool
-gpu_smmu_translate(uint32_t bank, uint32_t va, uint64_t *par)
-{
-	uint32_t i;
-
-	gpu_wr64(gpu_smmu, bank + SMMU_CB_ATS1PR, va);
-	/* ATSR bit 0 is ACTIVE while the walk runs; PAR is only valid after it
-	 * clears. */
-	for (i = 1; i <= 200; ++i) {
-		if (!(gpu_rd(gpu_smmu, bank + SMMU_CB_ATSR) & 1u)) {
-			break;
-		}
-		delay(100);
-	}
-	*par = gpu_rd64(gpu_smmu, bank + SMMU_CB_PAR);
-	return i <= 200;
-}
-
-/* One probe line; returns 1 when the result is what the tables say. */
-static bool
-gpu_smmu_probe(uint32_t bank, uint32_t va, uint32_t pa, bool mapped)
-{
-	uint64_t par = 0;
-	bool done = gpu_smmu_translate(bank, va, &par);
-	bool right = done && (mapped ?
-	    !(par & SMMU_PAR_FAULT) && (par & SMMU_PAR_PA) == pa :
-	    (par & SMMU_PAR_FAULT) != 0);
-
-	printf("SWEET GPU: smmu ats %#x %s done=%u par=%#llx %s\n", va,
-	    mapped ? "map" : "miss", done, (unsigned long long)par,
-	    right ? "right" : "WRONG");
