-	printf("SWEET GPU: hfi post store init=%#x ao=%#x fence=%#x\n",
-	    gpu_rd(gpu_gmu, GMU_HFI_CTRL_INIT), gpu_gmu_ao_counter(),
-	    gpu_rd(gpu_gmu, GMU_AHB_FENCE_STATUS));
-	(void)sweet_log_sync();
-	for (i = 1; i <= 1000; ++i) {
-		v = gpu_rd(gpu_gmu, GMU_HFI_CTRL_STATUS);
-		if (v & 1u) {
-			break;
-		}
-		delay(100);
-	}
-	printf("SWEET GPU: hfi ctrl polls=%u status=%#x\n", i, v);
-	gpu_smmu_fault("post-hfi");
-	(void)sweet_log_sync();
-	if (i > 1000) {
-		return false;
-	}
-	/* The messages go first: GPU_SET is only serviced once the firmware's
-	 * HFI task runs, and the Trogdor port does the same in resume order. */
-	if (!gpu_hfi_send(HFI_MSG_INIT, init, 5)) {
-		printf("SWEET GPU: hfi: no init ack\n");
-		return false;
-	}
-	if (!gpu_hfi_send(HFI_MSG_FW_VERSION, version, 2)) {
-		printf("SWEET GPU: hfi: no version ack\n");
