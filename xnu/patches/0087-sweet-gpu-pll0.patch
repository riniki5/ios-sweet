+/*
+ * Start a Fabia PLL the way clk_fabia_pll_configure()/enable() do it: fresh
+ * config registers (the dumped 0x20485699/0x2067 set matches gpu_cc_pll0),
+ * L and fractional part, then reset, OPMODE RUN, lock, output enable.
+ */
+static bool
+gpu_pll_start(vm_offset_t base, uint32_t off, uint32_t l, uint32_t frac, const char *name)
+{
+	gpu_wr(base, off + PLL_FABIA_CAL_L_VAL, 0x3fu);
+	gpu_wr(base, off + PLL_L_VAL, l);
+	gpu_wr(base, off + PLL_FABIA_FRAC_VAL, frac);
+	gpu_wr(base, off + PLL_CONFIG_CTL_LO, 0x20485699u);
+	gpu_wr(base, off + PLL_CONFIG_CTL_HI, 0x00002067u);
+	gpu_wr(base, off + PLL_USER_CTL_LO, 0x00000001u);
+	gpu_wr(base, off + PLL_USER_CTL_HI, 0x00004805u);
+	gpu_wr(base, off + PLL_TEST_CTL_LO, 0x00000000u);
+	gpu_wr(base, off + PLL_TEST_CTL_HI, 0x40000000u);
+
+	uint32_t mode = gpu_rd(base, off + PLL_MODE);
+	mode |= PLL_MODE_HW_UPDATE_BYPASS;
+	gpu_wr(base, off + PLL_MODE, mode & ~PLL_MODE_OUTCTRL);
+	gpu_wr(base, off + PLL_OPMODE, 0);
+	gpu_wr(base, off + PLL_MODE, mode | PLL_MODE_RESET_N);
+	gpu_wr(base, off + PLL_OPMODE, 1);
+
+	bool locked = false;
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (gpu_rd(base, off + PLL_STATUS) & PLL_STATUS_LOCK) {
+			locked = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!locked) {
+		printf("SWEET GPU: %s did not lock, status %#x mode=%#x\n", name,
+		    gpu_rd(base, off + PLL_STATUS), gpu_rd(base, off + PLL_MODE));
+		return false;
+	}
+	gpu_wr(base, off + PLL_USER_CTL_LO,
+	    gpu_rd(base, off + PLL_USER_CTL_LO) | PLL_USER_OUT_MASK);
+	gpu_wr(base, off + PLL_MODE, gpu_rd(base, off + PLL_MODE) | PLL_MODE_OUTCTRL);
+	printf("SWEET GPU: %s locked L=%#x frac=%#x out=%#x\n", name,
+	    gpu_rd(base, off + PLL_L_VAL), gpu_rd(base, off + PLL_FABIA_FRAC_VAL),
+	    gpu_rd(base, off + PLL_MODE));
+	return true;
+}
+
+/* Point an RCG at a new parent and wait for its root clock to leave CLK_OFF. */
+static bool
+gpu_rcg_switch(vm_offset_t base, uint32_t cmd_off, uint32_t cfg, const char *name)
+{
+	gpu_wr(base, cmd_off + 4, cfg);
+	gpu_wr(base, cmd_off, RCG_ROOT_EN | RCG_UPDATE);
+	for (unsigned i = 0; i < 100; ++i) {
+		uint32_t v = gpu_rd(base, cmd_off);
+		if (!(v & RCG_UPDATE)) {
+			if (v & RCG_ROOT_OFF) {
+				printf("SWEET GPU: %s rooted at %#x but root still off (%#x)\n",
+				    name, cfg, v);
+				return false;
+			}
+			printf("SWEET GPU: %s rooted at %#x (%#x)\n", name, cfg, v);
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET GPU: %s update did not stick, %#x\n", name, gpu_rd(base, cmd_off));
+	return false;
+}
