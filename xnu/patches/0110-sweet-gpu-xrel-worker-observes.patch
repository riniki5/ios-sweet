 /*
+ * gpu_xrel=1: issue the release store from here instead of the boot thread.
+ * log53 showed the store returns in this context and that the boot thread dies
+ * right after starting it, so the worker also owns every post-release read:
+ * the boot thread must not touch the GMU after the core is released.
+ */
+static void
+gpu_cm3_release_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t val = 0;
+	int i;
+
+	printf("SWEET GPU: xrel thread up\n");
+	gpu_pause(200);
+	printf("SWEET GPU: xrel issuing sysreset=0\n");
+	gpu_pause(100);
+	gpu_wr(gpu_gmu, GMU_CM3_SYSRESET, 0);
+	printf("SWEET GPU: xrel store returned\n");
+	for (i = 0; i < 20; i++) {
+		gpu_pause(100);
+		val = gpu_rd(gpu_gmu, GMU_CM3_FW_INIT_RESULT);
+		if (val) {
+			printf("SWEET GPU: xrel fw-init=%#x after %d ms\n", val,
+			    (i + 1) * 100);
+			break;
+		}
+	}
+	if (!val) {
+		printf("SWEET GPU: xrel fw-init stayed 0 for 2000 ms\n");
+	}
+	gpu_pause(300);
+	printf("SWEET GPU: xrel sentinel=%#x\n",
+	    gpu_rd(gpu_gmu, GMU_CM3_ITCM + 0x130));
+	gpu_pause(300);
+	printf("SWEET GPU: xrel reset=%#x cm3-cfg=%#x busy=%#x\n",
+	    gpu_rd(gpu_gmu, GMU_CM3_SYSRESET),
+	    gpu_rd(gpu_gmu, GMU_CM3_CFG),
+	    gpu_rd(gpu_gmu, GMU_CM3_FW_BUSY));
+	gpu_pause(300);
+	printf("SWEET GPU: xrel hfi=%#x sptprac=%#x rpmh=%#x\n",
+	    gpu_rd(gpu_gmu, GMU_HFI_CTRL_STATUS),
+	    gpu_rd(gpu_gmu, GMU_SPTPRAC_PWR_STATUS),
+	    gpu_rd(gpu_gmu, GMU_RPMH_POWER_STATE));
+	gpu_pause(300);
+	printf("SWEET GPU: xrel thread done\n");
+}
+
+/*
  * A sixteen-word CM3 program: the image's reset vector and none of its code.
  * Word 0 stays the image's stack pointer (0x43f80, in GMU SRAM), word 1 points
  * at 0x100, and words 2-15 all point there too so an exception lands in the
@@ -1846,6 +1925,8 @@
 	gpu_wr(gpu_gmu, GMU_CM3_BOOT_CONFIG, 0);
 	gpu_wr(gpu_gmu, GMU_AHB_FENCE_RANGE_0, GMU_FENCE_RANGE_MASK);
 	gpu_wr(gpu_gmu, GMU_HFI_SFR_ADDR, 0x06018000u);
+	printf("SWEET GPU: fence-range0 %#x\n",
+	    gpu_rd(gpu_gmu, GMU_AHB_FENCE_RANGE_0));
 	gpu_gmu_prestart();
 	printf("SWEET GPU: gmu preset done, no gmu read yet\n");
 	gpu_pause(300);
@@ -1866,6 +1947,41 @@
 		gpu_gmu_stub(stub);
 		gpu_pause(300);
 	}
+	/*
+	 * The GMU's hardware clock window: gpucc-sdmmagpie.c sets WAKE/SLEEP to
