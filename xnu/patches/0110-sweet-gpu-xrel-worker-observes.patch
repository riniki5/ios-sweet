+	if (xrel) {
+		thread_t th;
+		kern_return_t kr;
+
+		printf("SWEET GPU: xrel release from a second thread\n");
+		gpu_pause(300);
+		printf("SWEET GPU: xrel calling kernel_thread_start\n");
+		kr = kernel_thread_start(gpu_cm3_release_thread, NULL, &th);
+		printf("SWEET GPU: xrel start returned kr=%d\n", (int)kr);
+		if (kr != KERN_SUCCESS) {
+			printf("SWEET GPU: xrel thread start failed\n");
+		} else {
+			thread_deallocate(th);
+			printf("SWEET GPU: xrel dealloc returned\n");
+		}
+		gpu_pause(800);
+		printf("SWEET GPU: xrel main alive after release window\n");
+		gpu_pause(300);
+		return false;
+	}
