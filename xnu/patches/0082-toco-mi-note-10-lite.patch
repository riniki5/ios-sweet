+/* Distinct FIFO frames are few; log the first ones verbatim. */
+static unsigned touch_fts_ftm5_seen, touch_fts_ftm5_polls;
+static uint8_t touch_fts_ftm5_last[8];
+
+static void
+touch_fts_ftm5_trace(const uint8_t *e)
+{
+	unsigned same = 1;
+
+	for (unsigned i = 0; i < 8; ++i) {
+		if (e[i] != touch_fts_ftm5_last[i]) {
+			same = 0;
+			touch_fts_ftm5_last[i] = e[i];
+		}
+	}
+	if (same) {
+		return;
+	}
+	if (touch_fts_ftm5_seen++ < 48u) {
+		printf("SWEET TOUCH: fifo %02x %02x %02x %02x %02x %02x %02x %02x rem=%u\n",
+		    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7],
+		    e[7] & FTM5_EVT_LAST);
+	}
+}
+
+static int
+touch_fts_ftm5_frame(int x[], int y[], uint32_t *mask)
+{
+	uint8_t e[8];
+	int err = touch_read(FTM5_ADDR, FTM5_FIFO_READ, false, e, sizeof(e));
+	if (err) {
+		return err;
+	}
+	touch_fts_ftm5_trace(e);
+	/* event[7] low 5 bits count the events still queued behind this one. */
+	for (unsigned n = 0; n < FTM5_FIFO_DEPTH; ++n) {
+		unsigned id = e[1] >> 4, type = e[1] & 15u;
+		if (e[0] == FTM5_EVT_ENTER || e[0] == FTM5_EVT_MOTION) {
+			/* Finger/glove/stylus/palm report contacts; 0 is invalid. */
+			if (type == 0 || type > 4u || id >= TOUCH_MAX) {
+				return EIO;
+			}
+			unsigned px = ((unsigned)(e[3] & 15u) << 8) | e[2];
+			unsigned py = ((unsigned)e[4] << 4) | ((e[3] & 0xf0u) >> 4);
+			px = px >= touch_panel_w ? touch_panel_w - 1 : px;
+			py = py >= touch_panel_h ? touch_panel_h - 1 : py;
+			*mask |= 1u << id;
+			x[id] = (int)px;
+			y[id] = (int)py;
+		} else if (e[0] == FTM5_EVT_LEAVE) {
+			if (id >= TOUCH_MAX) {
+				return EIO;
+			}
+			*mask &= ~(1u << id);
+		}
+		if (!(e[7] & FTM5_EVT_LAST)) {
+			break;
+		}
+		err = touch_read(FTM5_ADDR, FTM5_FIFO_READ, false, e, sizeof(e));
+		if (err) {
+			return err;
+		}
+		touch_fts_ftm5_trace(e);
+	}
+	return 0;
+}
+
+static int
+touch_fts_ftm5(void)
+{
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	int err = touch_fts_ftm5_frame(x, y, &mask);
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	/* Silence can mean no-event frames or a stalled poll loop. */
+	if ((++touch_fts_ftm5_polls % 1000u) == 0) {
+		printf("SWEET TOUCH: ftm5 idle polls=%u last=%02x%02x rem=%u irq=%#x\n",
+		    touch_fts_ftm5_polls, touch_fts_ftm5_last[0],
+		    touch_fts_ftm5_last[1], touch_fts_ftm5_last[7] & FTM5_EVT_LAST,
+		    touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u);
+	}
+	return err;
+}
+
+static int
+touch_fts_ftm5_probe(uint8_t *evt)
+{
+	int err = EIO;
+	/* The IC boots after reset; allow its firmware to bring the FIFO up. */
+	for (unsigned i = 0; i < 10; ++i) {
+		err = touch_read(FTM5_ADDR, FTM5_FIFO_READ, false, evt, 8);
+		if (!err && (evt[0] == 0x00u || (evt[0] & 15u) == 3u)) {
+			return 0;
+		}
+		err = EIO;
+		touch_wait(50);
+	}
+	return err;
+}
+
+/* FTS reads with a 16-bit offset: opcode plus a big-endian address. */
+static int
+touch_fts_read3(uint8_t op, uint16_t addr, uint8_t *buf, unsigned len)
+{
+	uint8_t tx[3] = { op, (uint8_t)(addr >> 8), (uint8_t)addr };
+	int err = touch_msg(touch_fts_addr, tx, sizeof(tx), NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	return touch_msg(touch_fts_addr, NULL, 0, buf, len, false);
+}
