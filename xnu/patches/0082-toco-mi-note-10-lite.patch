+
+/* The vendor pulses reset 20 ms low and then waits for controller ready. */
+static bool
+touch_fti_reset(void)
+{
+	touch_wr(st.gpio, TOUCH_GPIO_IO(8), 0u);
+	touch_wait(20);
+	touch_wr(st.gpio, TOUCH_GPIO_IO(8), 2u);
+	bool ready = touch_fti_wait_ready("reset", 1500);
+	if (!ready) {
+		int err = touch_fti_write(FTS_F_RESET, FTS_F_RESET_VAL);
+		printf("SWEET TOUCH: fti reg reset=%d, waiting again\n", err);
+		ready = touch_fti_wait_ready("regreset", 1000);
+	}
+	return ready;
+}
+
+static unsigned touch_fti_polls;
+static unsigned touch_fti_ev[16];
+static unsigned touch_fti_traced;
+static uint8_t touch_fti_last[2];
+
+static void
+touch_fti_trace(const uint8_t *e)
+{
+	if (e[0] == FTS_T_EVT_NONE || touch_fti_traced >= 48u) {
+		return;
+	}
+	++touch_fti_traced;
+	printf("SWEET TOUCH: fti evt %02x %02x %02x %02x %02x %02x %02x %02x irq=%#x\n",
+	    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7],
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u);
+}
+
+static int
+touch_fti_frame(int x[], int y[], uint32_t *mask)
+{
+	uint8_t e[8];
+
+	for (unsigned n = 0; n < FTS_T_FIFO_DEPTH; ++n) {
+		int err = touch_read(FTS_T_ADDR, FTS_F_FIFO, false, e, sizeof(e));
+		if (err) {
+			return err;
+		}
+		touch_fti_last[0] = e[0];
+		touch_fti_last[1] = e[1];
+		if (e[0] == FTS_T_EVT_NONE) {
+			break;
+		}
+		++touch_fti_ev[e[0] >> 4];
+		touch_fti_trace(e);
+		unsigned id = e[1] >> 4;
+		if (id >= TOUCH_MAX) {
+			return EIO;
+		}
+		if (e[0] == FTS_F_EVT_ENTER || e[0] == FTS_F_EVT_MOTION) {
+			unsigned px = ((unsigned)(e[3] & 0x0fu) << 8) | e[2];
+			unsigned py = ((unsigned)e[4] << 4) | ((e[3] & 0xf0u) >> 4);
+			px = px >= touch_panel_w ? touch_panel_w - 1 : px;
+			py = py >= touch_panel_h ? touch_panel_h - 1 : py;
+			*mask |= 1u << id;
+			x[id] = (int)px;
+			y[id] = (int)py;
+		} else if (e[0] == FTS_F_EVT_LEAVE) {
+			*mask &= ~(1u << id);
+		} else if (e[0] == FTS_F_EVT_READY) {
+			int serr = touch_fti_sense(true);
+			printf("SWEET TOUCH: fti controller ready, sense on=%d\n", serr);
+		} else if (e[0] == FTS_F_EVT_ERROR) {
+			printf("SWEET TOUCH: fti error event %02x %02x %02x\n",
+			    e[1], e[2], e[3]);
+		}
+	}
+	return 0;
+}
+
+static int
+touch_fti(void)
+{
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	int err = touch_fti_frame(x, y, &mask);
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	/*
+	 * Re-sample raw frames while the system runs so a finger on the panel
+	 * can be measured: every 20 s for the first 4 minutes, then every 2.
+	 */
+	++touch_fti_polls;
+	if (touch_fti_polls <= 24000u ? !(touch_fti_polls % 2000u) :
+	    !(touch_fti_polls % 12000u)) {
+		printf("SWEET TOUCH: fti reprobe at poll %u\n", touch_fti_polls);
+		touch_fti_rawprobe();
+	}
+	if ((touch_fti_polls % 1000u) == 0) {
+		printf("SWEET TOUCH: fti polls=%u last=%02x%02x irq=%#x enter=%u motion=%u leave=%u status=%u err=%u hdr=%u\n",
+		    touch_fti_polls, touch_fti_last[0], touch_fti_last[1],
+		    touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u,
+		    touch_fti_ev[1], touch_fti_ev[2], touch_fti_ev[3],
+		    touch_fti_ev[4], touch_fti_ev[15], touch_fti_frames());
+	}
+	return err;
+}
+
+static int
+touch_fts_toco(void)
+{
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	int err = touch_fts_toco_frame(x, y, &mask);
+	if (!err) {
+		touch_report(mask, x, y);
+	}
