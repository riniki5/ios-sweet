+/*
+ * FTI register access: 0xFA, four-byte big-endian address, then the data
+ * byte (writes) or the reply (reads). No dummy byte on I2C.
+ */
+static int
+touch_fti_read(uint32_t addr, uint8_t *buf, unsigned len)
+{
+	uint8_t tx[5] = { FTS_F_REG, (uint8_t)(addr >> 24), (uint8_t)(addr >> 16),
+	    (uint8_t)(addr >> 8), (uint8_t)addr };
+	int err = touch_msg(FTS_T_ADDR, tx, sizeof(tx), NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	return touch_msg(FTS_T_ADDR, NULL, 0, buf, len, false);
+}
+
+static int
+touch_fti_write(uint32_t addr, uint8_t val)
+{
+	uint8_t tx[6] = { FTS_F_REG, (uint8_t)(addr >> 24), (uint8_t)(addr >> 16),
+	    (uint8_t)(addr >> 8), (uint8_t)addr, val };
+
+	return touch_msg(FTS_T_ADDR, tx, sizeof(tx), NULL, 0, false);
+}
+
+/* FTI active scan: 0xA0, mode, scan bitmask. */
+static int
+touch_fti_sense(bool on)
+{
+	uint8_t cmd[3] = { FTS_F_SCAN, FTS_F_ACTIVE, on ? FTS_F_MT_BIT : 0u };
+
+	return touch_msg(FTS_T_ADDR, cmd, sizeof(cmd), NULL, 0, false);
+}
+
+/*
+ * FTI framebuffer read: 0xA6, sixteen-bit address, then exactly len bytes.
+ * The vendor sets DUMMY_FRAMEBUFFER=0 for the I2C interface
+ * (f521_ftsHardware.h:143); dropping a lead byte shifted every field by one.
+ * Address 0 holds the data header the FW reloads after every reset:
+ * signature, data id, then a little-endian count that moves when the host
+ * asks for fresh data.
+ */
+static int
+touch_fti_fbuf(uint16_t addr, uint8_t *buf, unsigned len)
+{
+	uint8_t tx[3] = { FTS_F_FBUF, (uint8_t)(addr >> 8), (uint8_t)addr };
+
+	int err = touch_msg(FTS_T_ADDR, tx, sizeof(tx), NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	return touch_msg(FTS_T_ADDR, NULL, 0, buf, len, false);
+}
+
+static unsigned
+touch_fti_frames(void)
+{
+	uint8_t h[4];
+
+	if (touch_fti_fbuf(0, h, sizeof(h))) {
+		return 0xffffffffu;
+	}
+	return (unsigned)h[2] | ((unsigned)h[3] << 8);
+}
