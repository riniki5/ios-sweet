+/* Distinct FIFO frames are few; log the first ones verbatim. */
+static unsigned touch_fts_toco_seen, touch_fts_toco_polls;
+static uint8_t touch_fts_toco_last[8];
+
+static void
+touch_fts_toco_trace(const uint8_t *e)
+{
+	unsigned same = 1;
+
+	for (unsigned i = 0; i < 8; ++i) {
+		if (e[i] != touch_fts_toco_last[i]) {
+			same = 0;
+			touch_fts_toco_last[i] = e[i];
+		}
+	}
+	if (same) {
+		return;
+	}
+	if (touch_fts_toco_seen++ < 48u) {
+		printf("SWEET TOUCH: fifo %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+	}
+}
+
+/*
+ * Read the FIFO until it reports no event. The stock st,fts event handlers:
+ * data[0] is the event id, data[1] low nibble the touch id and high nibble
+ * the contact count, x/y packed as 4+4 nibbles across data[2..4].
+ */
+static int
+touch_fts_toco_frame(int x[], int y[], uint32_t *mask)
+{
+	uint8_t e[8];
+
+	for (unsigned n = 0; n < FTS_T_FIFO_DEPTH; ++n) {
+		int err = touch_read(FTS_T_ADDR, FTS_T_FIFO_READ, false, e, sizeof(e));
+		if (err) {
+			return err;
+		}
+		touch_fts_toco_trace(e);
+		if (e[0] == FTS_T_EVT_NONE) {
+			break;
+		}
+		unsigned id = e[1] & 15u;
+		if (id >= TOUCH_MAX) {
+			return EIO;
+		}
+		if (e[0] == FTS_T_EVT_ENTER || e[0] == FTS_T_EVT_MOTION) {
+			unsigned px = ((unsigned)e[2] << 4) | ((e[4] & 0xf0u) >> 4);
+			unsigned py = ((unsigned)e[3] << 4) | (e[4] & 0x0fu);
+			px = px >= touch_panel_w ? touch_panel_w - 1 : px;
+			py = py >= touch_panel_h ? touch_panel_h - 1 : py;
+			*mask |= 1u << id;
+			x[id] = (int)px;
+			y[id] = (int)py;
+		} else if (e[0] == FTS_T_EVT_LEAVE) {
+			*mask &= ~(1u << id);
+		} else if (e[0] == FTS_T_EVT_READY) {
+			/* The IC rebooted (ESD): restore sensing as the vendor does. */
+			uint8_t on = FTS_T_SENSE_ON;
+			int serr = touch_msg(FTS_T_ADDR, &on, 1, NULL, 0, false);
+			printf("SWEET TOUCH: controller ready, sense on=%d\n", serr);
+		} else if (e[0] == FTS_T_EVT_ERROR) {
+			printf("SWEET TOUCH: error event %02x %02x %02x %02x\n",
+			    e[1], e[2], e[3], e[4]);
+		}
+	}
+	return 0;
+}
+
+static int
+touch_fts_toco(void)
+{
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	int err = touch_fts_toco_frame(x, y, &mask);
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	/* Silence can mean no-event reads or a stalled poll loop. */
+	if ((++touch_fts_toco_polls % 1000u) == 0) {
+		printf("SWEET TOUCH: toco idle polls=%u last=%02x%02x irq=%#x\n",
+		    touch_fts_toco_polls, touch_fts_toco_last[0],
+		    touch_fts_toco_last[1], touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u);
+	}
+	return err;
+}
+
+/* HW register read: 0xB6, 16-bit big-endian address, then one dummy byte. */
+static int
+touch_fts_toco_reg(uint16_t addr, uint8_t *val, unsigned n)
+{
+	uint8_t tx[3] = { FTS_T_REG_READ, (uint8_t)(addr >> 8), (uint8_t)addr };
+	uint8_t buf[4];
+	int err;
+
+	if (n > 3) {
+		return EINVAL;
+	}
+	err = touch_msg(FTS_T_ADDR, tx, sizeof(tx), NULL, 0, true);
+	if (!err) {
+		err = touch_msg(FTS_T_ADDR, NULL, 0, buf, n + 1, false);
+	}
+	for (unsigned i = 0; !err && i < n; ++i) {
+		val[i] = buf[i + 1];
+	}
+	return err;
+}
+
+/*
+ * The vendor always pulses reset (20 ms low) and then waits for the 0x10
+ * control-ready event before enabling sensing; a chip that was never
+ * pulsed answers I2C but never scans.
+ */
+static bool
+touch_fts_toco_reset(void)
+{
+	uint8_t e[8];
+
+	touch_wr(st.gpio, TOUCH_GPIO_IO(8), 2u);
+	touch_wait(20);
+	touch_wr(st.gpio, TOUCH_GPIO_IO(8), 3u);
+	for (unsigned i = 0; i < 40; ++i) {
+		touch_wait(25);
+		if (!touch_read(FTS_T_ADDR, FTS_T_FIFO_READ, false, e, sizeof(e)) &&
+		    e[0] == FTS_T_EVT_READY) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static int
+touch_fts_toco_probe(uint8_t *evt)
+{
+	int err = EIO;
+	/* The IC boots after reset; allow its firmware to bring the FIFO up. */
+	for (unsigned i = 0; i < 10; ++i) {
+		err = touch_read(FTS_T_ADDR, FTS_T_FIFO_READ, false, evt, 8);
+		if (!err && (evt[0] == FTS_T_EVT_NONE || evt[0] == FTS_T_EVT_ENTER ||
+		    evt[0] == FTS_T_EVT_LEAVE || evt[0] == FTS_T_EVT_MOTION ||
+		    evt[0] == FTS_T_EVT_READY)) {
+			return 0;
+		}
+		err = EIO;
+		touch_wait(50);
+	}
+	return err;
+}
