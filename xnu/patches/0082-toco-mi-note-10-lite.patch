+/*
+ * Mirrors the vendor's ms_raw read: refresh a frame while scanning, stop,
+ * drain the FIFO, then ask the FW for a synchronized raw frame. After the
+ * load the header reads a5 30 (signature + LOAD_SYNC_FRAME_RAW) with a fresh
+ * count; the node data follows at offset 4. The fingerprint (nonzero nodes,
+ * min/max) taken with and without a finger is what proves whether the AFE
+ * actually sees the panel.
+ */
+static void
+touch_fti_rawprobe(void)
+{
+	uint8_t h[4], chunk[60];
+
+	(void)touch_fti_sense(true);
+	touch_wait(100);
+	(void)touch_fti_sense(false);
+	touch_wait(50);
+	for (unsigned i = 0; i < FTS_T_FIFO_DEPTH; ++i) {
+		uint8_t e[8];
+		if (touch_read(FTS_T_ADDR, FTS_F_FIFO, false, e, sizeof(e)) ||
+		    e[0] == FTS_T_EVT_NONE) {
+			break;
+		}
+	}
+	if (touch_fti_fbuf(0, h, sizeof(h))) {
+		printf("SWEET TOUCH: fti raw header err\n");
+		(void)touch_fti_sense(true);
+		return;
+	}
+	unsigned before = (unsigned)h[2] | ((unsigned)h[3] << 8);
+	uint8_t req[3] = { 0xa4, 0x06, 0x30 };
+	int err = touch_msg(FTS_T_ADDR, req, sizeof(req), NULL, 0, false);
+	bool ready = false;
+	unsigned after = before;
+	for (unsigned i = 0; i < 250; ++i) {
+		touch_wait(20);
+		if (touch_fti_fbuf(0, h, sizeof(h))) {
+			continue;
+		}
+		after = (unsigned)h[2] | ((unsigned)h[3] << 8);
+		if (h[0] == 0xa5 && h[1] == 0x30 && after != before) {
+			ready = true;
+			break;
+		}
+	}
+	printf("SWEET TOUCH: fti raw req=%d ready=%d count %u->%u hdr=%02x %02x\n",
+	    err, ready, before, after, h[0], h[1]);
+
+	unsigned nodes = 544;
+	uint8_t pc[8];
+	if (!touch_fti_fbuf(80, pc, sizeof(pc)) && pc[4] && pc[5]) {
+		nodes = (unsigned)pc[4] * (unsigned)pc[5];
+	}
+	unsigned bytes = nodes * 2u;
+	if (bytes > 1200u) {
+		bytes = 1200u;
+	}
+	unsigned nz = 0, mn = 0xffffu, mx = 0, sum = 0, got = 0;
+	for (unsigned off = 0; off < bytes; off += sizeof(chunk)) {
+		unsigned len = bytes - off < sizeof(chunk) ? bytes - off : sizeof(chunk);
+		if (touch_fti_fbuf((uint16_t)(4u + off), chunk, len)) {
+			break;
+		}
+		if (off < 40u && len >= 20u) {
+			printf("SWEET TOUCH: fti raw %04x: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    4u + off, chunk[0], chunk[1], chunk[2], chunk[3],
+			    chunk[4], chunk[5], chunk[6], chunk[7], chunk[8],
+			    chunk[9], chunk[10], chunk[11], chunk[12], chunk[13],
+			    chunk[14], chunk[15], chunk[16], chunk[17], chunk[18],
+			    chunk[19]);
+		}
+		for (unsigned i = 0; i + 1 < len; i += 2) {
+			unsigned v = (unsigned)chunk[i] | ((unsigned)chunk[i + 1] << 8);
+			if (v) {
+				++nz;
+			}
+			if (v < mn) {
+				mn = v;
+			}
+			if (v > mx) {
+				mx = v;
+			}
+			sum += v;
+		}
+		got += len;
+	}
+	printf("SWEET TOUCH: fti raw frame nodes=%u got=%u nz=%u min=%04x max=%04x sum=%u\n",
+	    nodes, got, nz, got ? mn : 0, mx, sum);
+	(void)touch_fti_sense(true);
+}
