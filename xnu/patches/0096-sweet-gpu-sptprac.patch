 /*
+ * SPTPRAC is the GPU's internal power domain. In the vendor tree only GMU
+ * firmware touches A6XX_GMU_GX_SPTPRAC_POWER_CONTROL, but the register itself
+ * sits in the always-on GMU block, and the GMU already tracks our GX GDSC
+ * (SPTPRAC status bit 6 cleared as soon as the GDSC came up) while GX_CLK_OFF
+ * stayed set. Drive it directly and see whether the GX clock leaves halt.
+ */
+static void
+gpu_sptprac_on(void)
+{
+	if (!gpu_gmu || !gpu_gmu_live) {
+		return;
+	}
+	unsigned i;
+	uint32_t st = gpu_rd(gpu_gmu, GMU_SPTPRAC_PWR_STATUS);
+
+	printf("SWEET GPU: sptprac before: ctrl=%#x status=%#x\n",
+	    gpu_rd(gpu_gmu, GMU_GX_SPTPRAC_CTRL), st);
+	gpu_wr(gpu_gmu, GMU_GX_SPTPRAC_CTRL, GMU_SPTPRAC_ON_CTRL);
+	for (i = 0; i < 1000; ++i) {
+		st = gpu_rd(gpu_gmu, GMU_SPTPRAC_PWR_STATUS);
+		if (st & GMU_SPTPRAC_ON_STATUS) {
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET GPU: sptprac after %u us: ctrl=%#x status=%#x (%s)\n", i,
+	    gpu_rd(gpu_gmu, GMU_GX_SPTPRAC_CTRL), st,
+	    (st & GMU_SPTPRAC_ON_STATUS) ? "on" : "timeout");
+	printf("SWEET GPU: after sptprac: gx branch=%#x rcg=%#x\n",
+	    gpu_rd(gpu_cc, GPUCC_GX_GFX3D_CBCR), gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG));
+}
