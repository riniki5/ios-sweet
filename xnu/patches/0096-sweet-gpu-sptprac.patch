  * result back from SPTPRAC_PWR_CLK_STATUS. With the CM3 still in reset those
@@ -620,6 +659,7 @@
 	 */
 	gpu_gmu_fence_allow("gx-on");
 	gpu_gmu_report("gx-on");
+	gpu_sptprac_on();
 	printf("SWEET GPU: gmu_rcg cmd=%#x cfg=%#x branch=%#x\n",
 	    gpu_rd(gpu_cc, GPUCC_GMU_RCG), gpu_rd(gpu_cc, GPUCC_GMU_RCG + 4),
 	    gpu_rd(gpu_cc, GPUCC_CX_GMU_CBCR));
