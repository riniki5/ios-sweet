+/* Pick the highest hardware level whose mapped RPMH level stays <= target. */
+static int
+rh_arc_pick(const char *res, uint32_t aux, unsigned auxlen, unsigned target, unsigned *hw)
+{
+	unsigned best = 0;
+	bool found = false;
+	for (unsigned i = 0; i < auxlen / 2 && i < 16; ++i) {
+		unsigned lvl = rh_db16(aux + 2u * i);
+		printf("SWEET RPMH: ARC %s level[%u]=%u\n", res, i, lvl);
+		if (lvl == 0) {
+			/* The cmd-db map is zero padded; a zero ends the valid range. */
+			break;
+		}
+		if (lvl <= target && lvl > RH_LEVEL_OFF) {
+			best = i;
+			found = true;
+		}
+	}
+	if (!found) {
+		printf("SWEET RPMH: ARC %s has no level at or below %u\n", res, target);
+		return ENODEV;
+	}
+	*hw = best;
+	return 0;
+}
+
+/*
+ * Vote an ARC rail up to a consumer level (RPMH_REGULATOR_LEVEL_*). Only one
+ * write transaction: the level register and the pseudo-enable, like
+ * rpmh_regulator_arc_set_voltage_sel().
+ */
+int
+sweet_rpmh_arc_raise(const char *res, unsigned target)
+{
+	static const char *const allowed[] = {"cx.lvl", "mx.lvl", "gfx.lvl"};
+	bool ok = false;
+	for (unsigned i = 0; i < sizeof(allowed) / sizeof(allowed[0]); ++i) {
+		ok |= res && !strcmp(res, allowed[i]);
+	}
+	if (!ok) {
+		printf("SWEET RPMH: ARC raise of %s is not allowed\n", res ? res : "(null)");
+		return EINVAL;
+	}
+	if (!rh_lock_wait()) {
+		printf("SWEET RPMH: ARC raise of %s: rpmh busy, skipped\n", res);
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, aux = 0;
+	unsigned auxlen = 0, hw = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC raise\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_arc_lookup(res, &address, &aux, &auxlen);
+	}
+	if (!error) {
+		error = rh_arc_pick(res, aux, auxlen, target, &hw);
+	}
+	if (!error) {
+		const uint32_t offsets[2] = {0, RH_ARC_ENABLE_OFF};
+		const uint32_t values[2] = {hw, 1};
+		printf("SWEET RPMH: ARC %s addr=%#x raise to hw level %u (target %u)\n",
+		    res, address, hw, target);
+		error = rh_send_cmds(address, offsets, values, 2);
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
