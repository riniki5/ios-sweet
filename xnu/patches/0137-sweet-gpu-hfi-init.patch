+/*
+ * One HFI message and its acknowledgement, a6xx_hfi.c legacy wire format: the
+ * message goes into the command queue, whose read/write indices live at +40
+ * and +44 of the queue header, and the doorbell is host2gmu bit 0.
+ */
+static bool
+gpu_hfi_send(uint32_t id, uint32_t *msg, uint32_t dwords)
+{
+	static uint32_t seq;
+	uint32_t at, i, read, size, response[24];
+	bool acked = false;
+
+	msg[0] = ((++seq << 20) | (dwords << 8) | id);
+	at = gpu_pool_rd(HFI_CMD_HEADER + HFI_WRITE_INDEX);
+	for (i = 0; i < dwords; ++i) {
+		gpu_pool_wr(HFI_CMD_DATA + at * 4u, msg[i]);
+		at = (at + 1u) % HFI_QUEUE_WORDS;
+	}
+	gpu_pool_wr(HFI_CMD_HEADER + HFI_WRITE_INDEX, at);
+	gpu_wr(gpu_gmu, GMU_HOST2GMU_INTR_SET, 1u);
+	for (i = 1; i <= 3000; ++i) {
+		if (gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO) & 1u) {
+			break;
+		}
+		delay(100);
+	}
+	printf("SWEET GPU: hfi msg %u polls=%u info=%#x\n", id, i,
+	    gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO));
+	(void)sweet_log_sync();
+	if (i > 3000) {
+		return false;
+	}
+	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_CLR, 1u);
+	for (unsigned tries = 0; tries < 8 && !acked; ++tries) {
+		read = gpu_pool_rd(HFI_RSP_HEADER + HFI_READ_INDEX);
+		if (read == gpu_pool_rd(HFI_RSP_HEADER + HFI_WRITE_INDEX) ||
+		    read >= HFI_QUEUE_WORDS) {
+			break;
+		}
+		size = (gpu_pool_rd(HFI_RSP_DATA + read * 4u) >> 8) & 0xffu;
+		if (!size || size > sizeof(response) / sizeof(response[0])) {
+			printf("SWEET GPU: hfi msg %u answer size %u\n", id, size);
+			break;
+		}
+		for (i = 0; i < size; ++i) {
+			response[i] = gpu_pool_rd(HFI_RSP_DATA + read * 4u);
+			read = (read + 1u) % HFI_QUEUE_WORDS;
+		}
+		gpu_pool_wr(HFI_RSP_HEADER + HFI_READ_INDEX, read);
+		if ((response[0] & 0xffu) == HFI_MSG_ERROR) {
+			printf("SWEET GPU: hfi fw error %#x for msg %u\n",
+			    size > 1 ? response[1] : 0u, id);
+			continue;
+		}
+		if (((response[1] >> 20) & 0xfffu) != seq) {
+			continue;
+		}
+		printf("SWEET GPU: hfi msg %u ack status=%u payload=%#x\n", id,
+		    response[2], response[3]);
+		(void)sweet_log_sync();
+		acked = response[2] == 0;
+	}
+	return acked;
+}
+
+/*
+ * The handshake a6xx_gmu_resume runs once FW_INIT_RESULT is in: tell the CM3
+ * which rail entries to vote, let it boot GX and acknowledge, power SPTPRAC,
+ * start the HFI queues, then hand the firmware an address space and ask it
+ * what version it is.
+ */
+static bool
+gpu_gmu_hfi_start(void)
+{
+	uint32_t v = 0, i;
+	uint32_t init[5] = { 0, 0, gpu_pool_pa + GMU_POOL_DEBUG,
+	    GMU_DEBUG_BYTES, 1 };
+	uint32_t version[2] = { 0, (1u << 28) | (1u << 19) | (1u << 17) };
+
+	printf("SWEET GPU: hfi begin t=%llu\n", gpu_uptime_ms());
+	(void)sweet_log_sync();
+	gpu_wr(gpu_gmu, GMU_BOOT_SLUMBER_OPTION, 0);
+	gpu_wr(gpu_gmu, GMU_GX_VOTE_IDX, GMU_GX_VOTE_TOP);
+	gpu_wr(gpu_gmu, GMU_MX_VOTE_IDX, GMU_MX_VOTE_TOP);
+	gpu_wr(gpu_gmu, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_BOOT_SET);
+	for (i = 1; i <= 10000; ++i) {
+		v = gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO);
+		if (v & (1u << GMU_OOB_BOOT_ACK)) {
+			break;
+		}
+		delay(100);
+	}
+	printf("SWEET GPU: hfi boot oob polls=%u info=%#x\n", i, v);
+	(void)sweet_log_sync();
+	if (i > 10000) {
+		return false;
+	}
+	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_CLR, 1u << GMU_OOB_BOOT_ACK);
+	gpu_sptprac_on();
+	gpu_wr(gpu_gmu, GMU_HFI_CTRL_INIT, 1);
+	for (i = 1; i <= 10000; ++i) {
+		v = gpu_rd(gpu_gmu, GMU_HFI_CTRL_STATUS);
+		if (v & 1u) {
+			break;
+		}
+		delay(100);
+	}
+	printf("SWEET GPU: hfi ctrl polls=%u status=%#x\n", i, v);
+	(void)sweet_log_sync();
+	if (i > 10000) {
+		return false;
+	}
+	/* The messages go first: GPU_SET is only serviced once the firmware's
+	 * HFI task runs, and the Trogdor port does the same in resume order. */
+	if (!gpu_hfi_send(HFI_MSG_INIT, init, 5)) {
+		printf("SWEET GPU: hfi: no init ack\n");
+		return false;
+	}
+	if (!gpu_hfi_send(HFI_MSG_FW_VERSION, version, 2)) {
+		printf("SWEET GPU: hfi: no version ack\n");
+		return false;
+	}
+	gpu_wr(gpu_gmu, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_GPU_SET);
+	for (i = 1; i <= 10000; ++i) {
+		v = gpu_rd(gpu_gmu, GMU_GMU2HOST_INTR_INFO);
+		if (v & (1u << GMU_OOB_GPU_ACK)) {
+			break;
+		}
+		delay(100);
+	}
+	printf("SWEET GPU: hfi gpu oob polls=%u info=%#x\n", i, v);
+	(void)sweet_log_sync();
+	if (i > 10000) {
+		return false;
+	}
+	gpu_wr(gpu_gmu, GMU_GMU2HOST_INTR_CLR, 1u << GMU_OOB_GPU_ACK);
+	return true;
+}
