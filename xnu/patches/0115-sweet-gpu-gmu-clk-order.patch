  * driver had gmu_clk_src rooted on TCXO 19.2 MHz. 0114 re-roots it on
  * P_GPLL0_OUT_MAIN_DIV (parent 6) with the 1.5 hidden divider (pre_div 2) and
  * prints the mux readback.
+ * 0114 (stub 2) never flushed a line: the ring header still showed log57's
+ * total, so the machine stopped before the log thread's first second. The mux
+ * write ran from gpu_gmu_prestart(), i.e. with gpu_cc_cx_gmu_clk already
+ * enabled, and it pointed the RCG at parent 6 without first enabling that
+ * parent's GCC branch (gcc_gpu_gpll0_div_clk_src, 0x52004 bit 16), which the
+ * clock framework would have turned on before a clk_set_rate(). 0115 does
+ * both: enable the GCC branch, then program the mux from sweet_gpu_init()
+ * while the GMU branch is still off, vendor gmu_enable_clks() order.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -188,6 +196,12 @@
 #define GCC_GPU_MEMNOC_CBCR     0x7100cu
 #define GCC_GPU_SNOC_DVM_CBCR   0x71018u
 #define GCC_GPU_GPLL0_CTL       0x52004u
+/* 0x52000 bit 0 enables gpll0, bit 16 of 0x52004 its /2 divider branch
+ * (gcc_gpu_gpll0_div_clk_src), which is the parent gpu_cc_gmu_clk_src needs
+ * for 200 MHz. Branch halt is bit 31 of the enable register. */
+#define GCC_GPU_GPLL0           0x52000u
+#define GCC_GPU_GPLL0_DIV_EN    (1u << 16)
+#define GCC_BRANCH_HALT         (1u << 31)
 
 /* GPUCC (gpucc-sdmmagpie.c; regmap stride 4, max 0x8008). */
 #define GPUCC_GX_SW_RESET       0x1008u
@@ -1772,6 +1786,45 @@
 }
 
 /*
+ * gpu_gmuclk=1 gave gpu_cc_gmu_clk_src a source, but TCXO (19.2 MHz) is the
+ * one source the bootloader leaves; mainline calls clk_set_rate(core_clk,
+ * 200 MHz) "to bring up the GMU" and the toco DTB's gmu-pwrlevels[1] is
+ * 200 MHz, so 0115 programs that rate the way vendor gmu_enable_clks() does:
+ * set_rate, then enable the branch. Done from sweet_gpu_init() before
+ * A6XX_GMU_CX_GMU_WFI_CONFIG's branch (gpu_cc_cx_gmu_clk) is enabled, because
+ * 0114 reprogrammed the mux from gpu_gmu_prestart() - i.e. with the GMU branch
+ * already live - and the boot stopped there without flushing a single line.
+ * Parent 6 is gcc_gpu_gpll0_div_clk_src (gpll0 / 2 = 300 MHz); its GCC branch
+ * at 0x52004 bit 16 is off at boot and the clock framework would have enabled
+ * it implicitly, which is the other half of what 0114 was missing.
+ */
+static void
+gpu_gmu_clk_rate(void)
+{
+	uint32_t ctl = gpu_rd(gpu_gcc, GCC_GPU_GPLL0_CTL);
+
+	printf("SWEET GPU: gmu200 gpll0=%#x ctl=%#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_GPLL0), ctl);
+	if (!(ctl & GCC_GPU_GPLL0_DIV_EN)) {
+		gpu_wr(gpu_gcc, GCC_GPU_GPLL0_CTL, ctl | GCC_GPU_GPLL0_DIV_EN);
+		for (unsigned i = 0; i < 100; ++i) {
+			if (!(gpu_rd(gpu_gcc, GCC_GPU_GPLL0_CTL) & GCC_BRANCH_HALT)) {
+				break;
+			}
+			delay(1);
+		}
+		printf("SWEET GPU: gmu200 gpll0_div %#x -> %#x\n", ctl,
+		    gpu_rd(gpu_gcc, GCC_GPU_GPLL0_CTL));
+	}
+	gpu_rcg_switch(gpu_cc, GPUCC_GMU_RCG, RCG_CFG_GPLL0_DIV200,
+	    "gmu_clk_src 200 MHz");
+	printf("SWEET GPU: gmu200 src=%#x/%#x cx-gmu=%#x gx-gmu=%#x\n",
+	    gpu_rd(gpu_cc, GPUCC_GMU_RCG), gpu_rd(gpu_cc, GPUCC_GMU_RCG_CFG),
+	    gpu_rd(gpu_cc, GPUCC_CX_GMU_CBCR),
+	    gpu_rd(gpu_cc, GPUCC_GX_GMU_CBCR));
+}
+
+/*
  * Cold boot the way a6xx_gmu_fw_start()/a6xx_gmu_start() do: TCM retention,
  * the image in TCM, CM3_BOOT_CONFIG = TCM_BOOT, the AHB fence range, the
  * chipid SFR (0x06010800 compressed to minor<<12|patch<<8), then
@@ -1854,26 +1907,9 @@
