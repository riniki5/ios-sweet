-		 * the GMU" (a6xx_gmu_resume: clk_set_rate(core_clk, 200 MHz)) and the
-		 * vendor takes DEFAULT_GMU_FREQ_IDX 1 = 200 MHz from the toco DTB's
-		 * gmu-pwrlevels; this driver had the mux rooted on TCXO (19.2 MHz).
-		 * Parent 6 is P_GPLL0_OUT_MAIN_DIV, whose 1.5 divider is pre_div 2 in
-		 * the rcg2 encoding (rate = parent * 2 / (pre_div + 1)). */
-		printf("SWEET GPU: gmu_clk_src %#x/%#x -> GPLL0_DIV 200 MHz\n",
-		    rcg, cfg);
-		gpu_wr(gpu_cc, GPUCC_GMU_RCG_CFG, RCG_CFG_GPLL0_DIV200);
-		gpu_wr(gpu_cc, GPUCC_GMU_RCG, RCG_UPDATE);
-		delay(1);
-		gpu_wr(gpu_cc, GPUCC_GMU_RCG, RCG_ROOT_EN);
-		for (unsigned i = 0; i < 100; ++i) {
-			if (!(gpu_rd(gpu_cc, GPUCC_GMU_RCG) & RCG_ROOT_OFF)) {
-				break;
-			}
-			delay(1);
-		}
-		printf("SWEET GPU: gmu_clk_src now %#x/%#x cx-gmu=%#x gx-gmu=%#x\n",
+		/* 0115 programs the rate from gpu_gmu_clk_rate(), before this branch
+		 * exists; here it only reads what that left behind. */
+		printf("SWEET GPU: gmu clk src=%#x/%#x cx-gmu=%#x gx-gmu=%#x\n",
 		    gpu_rd(gpu_cc, GPUCC_GMU_RCG), gpu_rd(gpu_cc, GPUCC_GMU_RCG_CFG),
 		    gpu_rd(gpu_cc, GPUCC_CX_GMU_CBCR),
 		    gpu_rd(gpu_cc, GPUCC_GX_GMU_CBCR));
@@ -2297,7 +2333,17 @@
 		 * probe only fixes up its WAKEUP/SLEEP fields, which stock reads
 		 * back as 0x80004ff0, so the enable bit is all that is ours.
 		 * It has to be on before the GMU aperture is read below.
+		 *
+		 * The rate goes in first: vendor gmu_enable_clks() calls
