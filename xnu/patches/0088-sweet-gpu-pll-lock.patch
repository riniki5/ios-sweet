 	}
 	gpu_wr(base, off + PLL_USER_CTL_LO,
 	    gpu_rd(base, off + PLL_USER_CTL_LO) | PLL_USER_OUT_MASK);
 	gpu_wr(base, off + PLL_MODE, gpu_rd(base, off + PLL_MODE) | PLL_MODE_OUTCTRL);
-	printf("SWEET GPU: %s locked L=%#x frac=%#x out=%#x\n", name,
