+ * L and fractional part, then reset, OPMODE RUN, lock on PLL_MODE bit31 (the
+ * vendor wait_for_pll() reads PLL_MODE, not PLL_STATUS), then the output.
+ * A PLL the bootloader left locked only needs the new L/frac latched.
  */
 static bool
 gpu_pll_start(vm_offset_t base, uint32_t off, uint32_t l, uint32_t frac, const char *name)
 {
+	bool running = (gpu_rd(base, off + PLL_MODE) & PLL_MODE_LOCK_DET) != 0;
+
 	gpu_wr(base, off + PLL_FABIA_CAL_L_VAL, 0x3fu);
 	gpu_wr(base, off + PLL_L_VAL, l);
