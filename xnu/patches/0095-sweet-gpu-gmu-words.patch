 /*
+ * The AHB fence gates CPU access to the GPU register block: with GX powered
+ * and the fence closed every GPU register reads zero (adreno_irq_handler
+ * treats fence != 0 as "IRQ status and clear registers are not accessible").
+ * GMU firmware normally drops it to ALLOW; with the CM3 still in reset we
+ * write the ALLOW value ourselves and report whether it stuck.
+ */
+static void
+gpu_gmu_fence_allow(const char *when)
+{
+	if (!gpu_gmu || !gpu_gmu_live) {
+		return;
+	}
+	uint32_t f = gpu_rd(gpu_gmu, GMU_AO_AHB_FENCE_CTRL);
+	printf("SWEET GPU: gmu[%s] fence-ctl=%#x (%s) fence-status=%#x\n", when, f,
+	    f ? "closed" : "allow", gpu_rd(gpu_gmu, GMU_AHB_FENCE_STATUS));
+	if (f) {
+		gpu_wr(gpu_gmu, GMU_AO_AHB_FENCE_CTRL, 0);
+		delay(1);
+		f = gpu_rd(gpu_gmu, GMU_AO_AHB_FENCE_CTRL);
+		printf("SWEET GPU: gmu[%s] fence-ctl now %#x (%s)\n", when, f,
+		    f ? "still closed" : "allow");
+	}
+}
