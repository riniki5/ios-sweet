+	}
 	printf("SWEET GPU: releasing cm3: wfi=0\n");
 	gpu_pause(300);
 	gpu_wr(gpu_gmu, GMU_CX_GMU_WFI_CONFIG, 0);
@@ -1855,6 +1914,16 @@
 	    gpu_rd(gpu_gmu, GMU_HFI_CTRL_STATUS),
 	    gpu_rd(gpu_gmu, GMU_CM3_SYSRESET),
