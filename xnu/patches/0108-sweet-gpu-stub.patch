+/*
+ * A sixteen-word CM3 program: the image's reset vector and none of its code.
+ * Word 0 stays the image's stack pointer (0x43f80, in GMU SRAM), word 1 points
+ * at 0x100, and words 2-15 all point there too so an exception lands in the
+ * same loop instead of walking through a table the image only fills in later.
+ * The loop touches no stack and no memory but TCM, so nothing here depends on
+ * the SMMU, the RPMh sequencer or an HFI buffer.
+ */
+static void
+gpu_gmu_stub(int mode)
+{
+	uint32_t i;
+
+	for (i = 1; i < 16; ++i) {
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + i * 4, 0x00000101u);
+	}
+	if (mode == 1) {
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x100, 0xe7fee7feu);
+	} else {
+		/* ldr r3,[0x118]; ldr r2,[0x11c]; str r3,[r2];
+		 * ldr r2,[0x120]; ldr r1,[0x124]; str r1,[r2]; b . */
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x100, 0x4a064b05u);
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x104, 0x4a066013u);
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x108, 0x60114906u);
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x10c, 0xbf00e7feu);
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x118, 0x5eed1234u);
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x11c, 0x00000130u);
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x120, 0x00081714u);
+		gpu_wr(gpu_gmu, GMU_CM3_ITCM + 0x124, 0xbabefaceu);
+	}
+	printf("SWEET GPU: stub%d planted: vec1=%#x code=%#x sentinel=%#x\n",
+	    mode, gpu_rd(gpu_gmu, GMU_CM3_ITCM + 4),
+	    gpu_rd(gpu_gmu, GMU_CM3_ITCM + 0x100),
+	    gpu_rd(gpu_gmu, GMU_CM3_ITCM + 0x130));
+}
+
