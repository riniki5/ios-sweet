+		printf("SWEET GPU: stub%d sentinel=%#x fw-init=%#x\n", stub,
+		    gpu_rd(gpu_gmu, GMU_CM3_ITCM + 0x130), init);
+		gpu_wr(gpu_gmu, GMU_CM3_SYSRESET, 1);
+		printf("SWEET GPU: stub%d cm3 back in reset\n", stub);
