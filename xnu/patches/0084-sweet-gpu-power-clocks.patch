+static int
+rh_arc_lookup(const char *res, uint32_t *address, uint32_t *aux, unsigned *auxlen)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t auxhead = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) ||
+		    !rh_range(auxhead, 0)) {
+			printf("SWEET RPMH: malformed cmd-db header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			unsigned len = rh_db16(e + 20), off = rh_db16(e + 22);
+			if (slave != RH_ARC || ((addr >> 16) & 7u) != RH_ARC ||
+			    !rh_range(auxhead + off, len)) {
+				printf("SWEET RPMH: %s is not a plain ARC entry (slave=%u addr=%#x)\n",
+				    res, slave, addr);
+				return EINVAL;
+			}
+			*address = addr;
+			*aux = auxhead + off;
+			*auxlen = len;
+			++matches;
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: ARC %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+/*
+ * Read-only: dump the command-db entry for an ARC rail before anything votes
+ * on it. The aux data is the u16 hardware-level -> RPMH level map.
+ */
+int
+sweet_rpmh_arc_probe(const char *res)
+{
+	static const char *const allowed[] = {"cx.lvl", "mx.lvl", "gfx.lvl"};
+	bool ok = false;
+	for (unsigned i = 0; i < sizeof(allowed) / sizeof(allowed[0]); ++i) {
+		ok |= res && !strcmp(res, allowed[i]);
+	}
+	if (!ok) {
+		printf("SWEET RPMH: ARC probe of %s is not allowed\n", res ? res : "(null)");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, aux = 0;
+	unsigned auxlen = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC probe\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_arc_lookup(res, &address, &aux, &auxlen);
+	}
+	if (!error) {
+		printf("SWEET RPMH: ARC %s addr=%#x aux=%u bytes\n", res, address, auxlen);
+		for (unsigned i = 0; i < auxlen / 2 && i < 16; ++i) {
+			printf("SWEET RPMH: ARC %s level[%u]=%u\n", res, i, rh_db16(aux + 2u * i));
+		}
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
