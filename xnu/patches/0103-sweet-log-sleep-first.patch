  *   | u64 flush sequence
  * ring offset of byte n = n % ring size. Read it from a recovery with
  * tools/sweet-log-pull.sh. Disabled with boot-arg sweetlog=0.
- * The thread writes once before its first sleep and then every ufslogsecs
- * (default 10) seconds, or every hz/10 ticks with sweetlogfast=1; that
- * cadence is what lets a boot that hangs cleanly in the middle of driver
- * bring-up still leave its last steps on disk.
+ * The thread flushes every ufslogsecs (default 10) seconds, or every hz/10
+ * ticks with sweetlogfast=1. The first write stays behind that first sleep:
+ * writing before it stalled the boot at UFS init (log43), so a boot that dies
+ * inside the first 100 ms still leaves the previous ring untouched.
  */
 #define SWEET_LOG_SIZE          (4u << 20)
 #define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
@@ -753,46 +753,44 @@
 
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx),"
 	    " flush every %d ticks\n", SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base, wait);
-	/* Write before the first sleep: a boot that dies early still leaves a
-	 * header with its own seq/total, which tells the two apart from a stale
-	 * ring written by the previous boot. */
 	for (;;) {
