+/*
+ * The two host-side duties a6xx_gmu_start() performs before releasing the CM3
+ * that this probe still lacks: clear A6XX_GBIF_HALT (the reset sequence can
+ * leave the GPU's bus interface halted, and the GDSC power-up does not always
+ * release it) and give gpu_cc_gmu_clk_src a source. 0x1120 is the parent of
+ * both gpu_cc_cx_gmu_clk and gpu_cc_gx_gmu_clk and reads back 0/0, i.e. never
+ * configured; without a registered source the CM3 only has whatever the
+ * bootloader left. TCXO (19.2 MHz) is slow but is the one parent that needs
+ * no other block to be running.
+ */
+static void
+gpu_gmu_prestart(void)
+{
+	uint32_t halt = gpu_rd(gpu_core, GBIF_HALT);
+
+	printf("SWEET GPU: prestart gbif halt=%#x ack=%#x gmu_clk_src=%#x/%#x\n",
+	    halt, gpu_rd(gpu_core, GBIF_HALT_ACK), gpu_rd(gpu_cc, GPUCC_GMU_RCG),
+	    gpu_rd(gpu_cc, GPUCC_GMU_RCG_CFG));
+	if (halt != 0) {
+		gpu_wr(gpu_core, GBIF_HALT, 0);
+		delay(1);
+		printf("SWEET GPU: gbif halt now %#x ack=%#x\n",
+		    gpu_rd(gpu_core, GBIF_HALT), gpu_rd(gpu_core, GBIF_HALT_ACK));
+	}
+	if (gpu_rd(gpu_cc, GPUCC_GMU_RCG) & RCG_ROOT_OFF) {
+		gpu_wr(gpu_cc, GPUCC_GMU_RCG_CFG, RCG_CFG_XO);
+		gpu_wr(gpu_cc, GPUCC_GMU_RCG, RCG_UPDATE);
+		delay(1);
+		gpu_wr(gpu_cc, GPUCC_GMU_RCG, RCG_ROOT_EN);
+		for (unsigned i = 0; i < 100; ++i) {
+			if (!(gpu_rd(gpu_cc, GPUCC_GMU_RCG) & RCG_ROOT_OFF)) {
+				break;
+			}
+			delay(1);
+		}
+		printf("SWEET GPU: gmu_clk_src now %#x/%#x cx-gmu=%#x gx-gmu=%#x\n",
+		    gpu_rd(gpu_cc, GPUCC_GMU_RCG), gpu_rd(gpu_cc, GPUCC_GMU_RCG_CFG),
+		    gpu_rd(gpu_cc, GPUCC_CX_GMU_CBCR),
+		    gpu_rd(gpu_cc, GPUCC_GX_GMU_CBCR));
+	}
+}
