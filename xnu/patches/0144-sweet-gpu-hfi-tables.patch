 /*
+ * The PERF_TABLE the firmware gets: toco's GPU OPP table (stock boot.dtb,
+ * speed bin 0) against the cmd-db level maps log85 read -- gfx.lvl
+ * 0,16,64,128,192,256,320,384,416; mx.lvl 0,16,192,320,384; cx.lvl
+ * 0,16,64,128,192,256,384. A vote is level<<16 | mx index<<8 | rail index,
+ * a6xx_gmu_rpmh_arc_votes_init's encoding, and the same word
+ * GMU_GX_VOTE_IDX/GMU_MX_VOTE_IDX take in its low bytes.
+ */
+#define GMU_LEVELS_GX           9u
+#define GMU_LEVELS_CX           2u
+static const uint32_t gpu_gx_khz[GMU_LEVELS_GX] = { 0, 180000, 267000,
+    355000, 430000, 565000, 650000, 800000, 825000 };
+static const uint32_t gpu_gx_level[GMU_LEVELS_GX] = { 0, 16, 64, 128, 192,
+    256, 320, 384, 416 };
+static const uint32_t gpu_cx_khz[GMU_LEVELS_CX] = { 0, 200000 };
+static const uint32_t gpu_cx_level[GMU_LEVELS_CX] = { 0, 48 };
+static const uint32_t gpu_gfx_db[] = { 0, 16, 64, 128, 192, 256, 320, 384, 416 };
+static const uint32_t gpu_mx_db[] = { 0, 16, 192, 320, 384 };
+static const uint32_t gpu_cx_db[] = { 0, 16, 64, 128, 192, 256, 384 };
+
+static bool
+gpu_arc_vote(const uint32_t *pri, unsigned pri_count, const uint32_t *sec,
+    unsigned sec_count, uint32_t level, uint32_t *vote)
+{
+	unsigned pindex = pri_count, sindex = 0, j;
+
+	for (j = 0; j < pri_count; ++j) {
+		if (pri[j] >= level) {
+			pindex = j;
+			break;
+		}
+	}
+	if (pindex == pri_count) {
+		return false;
+	}
+	for (j = 0; j < sec_count; ++j) {
+		if (sec[j] >= level) {
+			sindex = j;
+			break;
+		}
+		if (sec[j]) {
+			sindex = j;
+		}
+	}
+	*vote = (pri[pindex] << 16) | (sindex << 8) | pindex;
+	return true;
+}
+
+static bool
+gpu_hfi_perf_table(uint32_t *perf)
+{
+	uint32_t vote;
+	unsigned i;
+
+	bzero(perf, HFI_PERF_DWORDS * 4u);
+	perf[1] = GMU_LEVELS_GX;
+	perf[2] = GMU_LEVELS_CX;
+	for (i = 0; i < GMU_LEVELS_GX; ++i) {
+		if (!gpu_arc_vote(gpu_gfx_db, sizeof(gpu_gfx_db) / sizeof(gpu_gfx_db[0]),
+		    gpu_mx_db, sizeof(gpu_mx_db) / sizeof(gpu_mx_db[0]),
+		    gpu_gx_level[i], &vote)) {
+			printf("SWEET GPU: hfi perf: GX level %u missing from cmd-db\n",
+			    gpu_gx_level[i]);
+			return false;
+		}
+		perf[3 + 2 * i] = vote;
+		perf[4 + 2 * i] = gpu_gx_khz[i];
+	}
+	for (i = 0; i < GMU_LEVELS_CX; ++i) {
+		if (!gpu_arc_vote(gpu_cx_db, sizeof(gpu_cx_db) / sizeof(gpu_cx_db[0]),
+		    gpu_mx_db, sizeof(gpu_mx_db) / sizeof(gpu_mx_db[0]),
+		    gpu_cx_level[i], &vote)) {
+			printf("SWEET GPU: hfi perf: CX level %u missing from cmd-db\n",
+			    gpu_cx_level[i]);
+			return false;
+		}
+		perf[35 + 2 * i] = vote;
+		perf[36 + 2 * i] = gpu_cx_khz[i];
+	}
+	printf("SWEET GPU: hfi perf gx_top=%#x cx_top=%#x\n",
+	    perf[3 + 2 * (GMU_LEVELS_GX - 1u)], perf[35 + 2 * (GMU_LEVELS_CX - 1u)]);
+	return true;
+}
+
+/*
+ * BW_TABLE for a GMU that does no bus scaling: one bandwidth level, one CNOC
+ * command and three DDR ones, all fixed votes (a6xx_hfi_send_bw_table).
+ */
+static void
+gpu_hfi_bw_table(uint32_t *bw)
+{
+	bzero(bw, HFI_BW_DWORDS * 4u);
+	bw[1] = 1;             /* bandwidth levels */
+	bw[2] = 1;             /* CNOC commands */
+	bw[3] = 3;             /* DDR commands */
+	bw[4] = 1;             /* CNOC wait bitmask */
+	bw[5] = 1;             /* DDR wait bitmask */
+	bw[6] = 0x5007cu;      /* CNOC address */
+	bw[12] = 0x40000000u;  /* CNOC data */
+	bw[18] = 0x60000001u;
+	bw[24] = 0x50000u;     /* DDR addresses */
+	bw[25] = 0x5003cu;
+	bw[26] = 0x5000cu;
+	bw[32] = bw[33] = bw[34] = 0x40000000u;
+}
