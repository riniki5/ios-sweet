@@ -686,7 +686,8 @@
  *   "SWEETLOG" | u32 version 1 | u32 ring size | u64 total bytes written
  *   | u64 flush sequence
  * ring offset of byte n = n % ring size. Read it from a recovery with
- * tools/sweet-log-pull.sh. Disabled with boot-arg sweetlog=0.
+ * tools/sweet-log-pull.sh or over USB with GETLOG. Disabled with boot-arg
+ * sweetlog=0; keep that disabled on a diagnostic boot to preserve this log.
  */
 #define SWEET_LOG_SIZE          (4u << 20)
 #define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
@@ -817,6 +818,52 @@
 	}
 }
 
+/* Snapshot before socket I/O so the logger cannot tear a transferred ring. */
+int
+sweet_log_export(char **out, size_t *size)
+{
+	const size_t bytes = SWEET_LOG_BLOCKS * UFS_BLOCK;
+	uint64_t base;
+	char *data;
+	int error = 0;
+
+	if (!su.ready || su.nblocks < SWEET_LOG_BLOCKS) {
+		return ENXIO;
+	}
+	data = kalloc_data(bytes, Z_WAITOK);
+	if (!data) {
+		return ENOMEM;
+	}
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint32_t done = 0; done < SWEET_LOG_BLOCKS && !error;) {
+		uint32_t count = MIN((uint32_t)(SWEET_LOG_BLOCKS - done),
+		    (uint32_t)(BOUNCE_SIZE / UFS_BLOCK));
+		error = ufs_read_blocks(base + done, count);
+		if (!error) {
+			memcpy(data + (size_t)done * UFS_BLOCK, (void *)(su.dma + DMA_BOUNCE),
+			    count * UFS_BLOCK);
+		}
+		done += count;
+	}
+	if (!error) {
+		struct sweet_log_header h;
+		memcpy(&h, data, sizeof(h));
+		if (memcmp(h.magic, "SWEETLOG", sizeof(h.magic)) || h.version != 1 ||
+		    h.size != SWEET_LOG_SIZE) {
+			error = ENODATA;
+		}
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		kfree_data(data, bytes);
+		return error;
+	}
+	*out = data;
+	*size = bytes;
+	return 0;
+}
