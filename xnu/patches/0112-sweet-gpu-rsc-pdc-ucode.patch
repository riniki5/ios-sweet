+/*
+ * a6xx_gmu_fw_start() runs _load_gmu_rpmh_ucode() unconditionally on cold boot
+ * and before the CM3 image: the RSCC sequencer runs the GPU's RPMh sleep/wake
+ * commands and the PDC owns the power-up sequence. Without it the CM3 never
+ * leaves reset on this part (log55: store accepted, busy=0, no FW_INIT_RESULT).
+ * a618 also takes the 0x30090 / 0x2 PDC variants.
+ */
+static void
+gpu_rpmh_ucode(void)
+{
+	uint32_t i;
+
+	printf("SWEET GPU: rpmh ucode begin rsc-status0=%#x\n",
+	    gpu_rd(gpu_gmu, GMU_RSCC_STATUS0));
+	gpu_wr(gpu_gmu, GMU_RSCC_STATUS0, 1u << 24);
+	gpu_wr(gpu_gmu, GMU_RSCC_PDC_SLAVE_ID, 1);
+	gpu_wr(gpu_gmu, GMU_RSCC_TCS_DATA, 0);
+	gpu_wr(gpu_gmu, GMU_RSCC_TCS_ADDR, 0);
+	gpu_wr(gpu_gmu, GMU_RSCC_TCS_DATA + RSC_CMD_OFFSET * 4, 0);
+	gpu_wr(gpu_gmu, GMU_RSCC_TCS_ADDR + RSC_CMD_OFFSET * 4, 0);
+	gpu_wr(gpu_gmu, GMU_RSCC_TCS_DATA + RSC_CMD_OFFSET * 8, 0x80000000u);
+	gpu_wr(gpu_gmu, GMU_RSCC_TCS_ADDR + RSC_CMD_OFFSET * 8, 0);
+	gpu_wr(gpu_gmu, GMU_RSCC_OVERRIDE_ADDR, 0);
+	gpu_wr(gpu_gmu, GMU_RSCC_PDC_SEQ_START, 0x4520u);
+	gpu_wr(gpu_gmu, GMU_RSCC_PDC_MATCH_LO, 0x4510u);
+	gpu_wr(gpu_gmu, GMU_RSCC_PDC_MATCH_HI, 0x4514u);
+	gpu_wr(gpu_gmu, GMU_RSCC_SEQ_MEM, 0xa7a506a0u);
+	gpu_wr(gpu_gmu, GMU_RSCC_SEQ_MEM + 4, 0xa1e6a6e7u);
+	gpu_wr(gpu_gmu, GMU_RSCC_SEQ_MEM + 8, 0xa2e081e1u);
+	gpu_wr(gpu_gmu, GMU_RSCC_SEQ_MEM + 12, 0xe9a982e2u);
+	gpu_wr(gpu_gmu, GMU_RSCC_SEQ_MEM + 16, 0x0020e8a8u);
+	printf("SWEET GPU: rpmh rsc status0 now %#x match %#x/%#x seq %#x\n",
+	    gpu_rd(gpu_gmu, GMU_RSCC_STATUS0),
+	    gpu_rd(gpu_gmu, GMU_RSCC_PDC_MATCH_LO),
+	    gpu_rd(gpu_gmu, GMU_RSCC_PDC_MATCH_HI),
+	    gpu_rd(gpu_gmu, GMU_RSCC_SEQ_MEM));
+	if (!gpu_pdc_cfg || !gpu_pdc_seq) {
+		printf("SWEET GPU: rpmh pdc window not mapped\n");
+		return;
+	}
+	gpu_pdc_seq[0] = 0xfebea1e1u;
+	for (i = 0; i < 5; ++i) {
+		static const uint32_t seq[5] = {
+			0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u,
+			0x002081fcu
+		};
+		gpu_pdc_seq[i] = seq[i];
+	}
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD_ENABLE_BANK] = 7;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD_WAIT_BANK] = 0;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CONTROL] = 0;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_MSGID] = 0x10108u;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_ADDR] = 0x30010u;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_DATA] = 1;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_MSGID + PDC_CMD_OFFSET] = 0x10108u;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_ADDR + PDC_CMD_OFFSET] = 0x30000u;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_DATA + PDC_CMD_OFFSET] = 0;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_MSGID + PDC_CMD_OFFSET * 2] = 0x10108u;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_ADDR + PDC_CMD_OFFSET * 2] = 0x30090u;
+	gpu_pdc_cfg[PDC_GPU_TCS1_CMD0_DATA + PDC_CMD_OFFSET * 2] = 0;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD_ENABLE_BANK] = 7;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD_WAIT_BANK] = 0;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CONTROL] = 0;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_MSGID] = 0x10108u;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_ADDR] = 0x30010u;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_DATA] = 2;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_MSGID + PDC_CMD_OFFSET] = 0x10108u;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_ADDR + PDC_CMD_OFFSET] = 0x30000u;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_DATA + PDC_CMD_OFFSET] = 2;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_MSGID + PDC_CMD_OFFSET * 2] = 0x10108u;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_ADDR + PDC_CMD_OFFSET * 2] = 0x30090u;
+	gpu_pdc_cfg[PDC_GPU_TCS3_CMD0_DATA + PDC_CMD_OFFSET * 2] = 3;
+	gpu_pdc_cfg[PDC_GPU_SEQ_START_ADDR] = 0;
+	gpu_pdc_cfg[PDC_GPU_ENABLE_PDC] = PDC_ENABLE_REG_VALUE;
+	printf("SWEET GPU: rpmh pdc enable=%#x tcs1-en=%#x seq0=%#x\n",
+	    gpu_pdc_cfg[PDC_GPU_ENABLE_PDC],
+	    gpu_pdc_cfg[PDC_GPU_TCS1_CMD_ENABLE_BANK], gpu_pdc_seq[0]);
+}
