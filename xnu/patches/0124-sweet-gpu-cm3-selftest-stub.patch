 static volatile int gpu_xrel_done;
 static volatile int gpu_xrel_ran;
 
+/*
+ * Stub 4 writes 0xBABEFACE to the firmware's own init-result address (CM3
+ * 0x81714) and is halted with the machine still alive, so the value is in
+ * whatever host register that address aliases - if it aliases one at all. Walk
+ * the register block in 0x400-word chunks and flush before each: a chunk that
+ * wedges the AHB then names itself on disk instead of taking the whole scan
+ * with it.
+ */
+static void
+gpu_gmu_scan_babeface(void)
+{
+	int hits = 0;
+
+	for (uint32_t base = 0x1a800; base <= 0x1fc00; base += 0x400) {
+		printf("SWEET GPU: scan %#x\n", base);
+		(void)sweet_log_sync();
+		for (uint32_t w = base; w < base + 0x400; ++w) {
+			if (gpu_rd(gpu_gmu, GMU_REG(w)) == 0xbabefaceu) {
+				printf("SWEET GPU: scan hit word=%#x\n", w);
+				++hits;
+			}
+		}
+	}
+	printf("SWEET GPU: scan done hits=%d\n", hits);
+	(void)sweet_log_sync();
+}
