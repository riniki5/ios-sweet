+ * stage4: movs r0,#4 ; str r0,[r6,#0xc]         about to read it back
+ *	ldr r1,[r7] ; str r1,[r6,#8]
+ * stage5: movs r0,#5 ; str r0,[r6,#0xc] ; b .
+ * A fault re-enters 0x100 through the vector table, so the entry counter grows
