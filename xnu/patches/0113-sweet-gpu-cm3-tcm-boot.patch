--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -136,6 +136,17 @@
  * and the PDC windows from the toco DTB (cfg 0xb290000, seq 0xb490000),
  * including the a618 variants (0x30090 selector, TCS3 data 0x2), behind
  * gpu_rpmh=1.
+ * log56 (0112, stub 2, gpu_xrel, gpu_rpmh): the whole RSCC/PDC load lands
+ * (rsc-status0 0x1000000, match 0x4510/0x4514, seq word 0xa7a506a0, pdc
+ * enable 0x80000001, tcs1-en 0x7) and the CM3 still does not fetch - sentinel
+ * 0, FW_INIT_RESULT 0, CM3_CFG 0x52. Comparing the remaining writes against
+ * the vendor's gmu_probe() turned up the real difference: it writes
+ * A6XX_GMU_CM3_BOOT_CONFIG = gmu->load_mode and sets that to TCM_BOOT, which
+ * is enum value 2 in this tree (CACHED_LOAD_BOOT 0, CACHED_BOOT 1, TCM_BOOT
+ * 2), while this driver has written 0 since 0098 - i.e. it has been telling
+ * the CM3 to boot the cached DRAM image every time, so the stub and the real
+ * firmware at ITCM 0 were never the boot image. 0113 writes TCM_BOOT and
+ * prints boot-cfg after the write.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -208,6 +219,11 @@
 
 #define GMU_CM3_SYSRESET        GMU_REG(0x1f800u)
 #define GMU_CM3_BOOT_CONFIG     GMU_REG(0x1f801u)
+/* kgsl_gmu.h enum gmu_load_mode: CACHED_LOAD_BOOT 0, CACHED_BOOT 1, TCM_BOOT 2.
+ * gmu_probe() sets gmu->load_mode = TCM_BOOT and fw_start() writes it here;
+ * 0098-0112 wrote 0, which makes the CM3 fetch the cached DRAM image instead
+ * of ITCM 0. */
+#define GMU_BOOT_TCM            2u
 #define GMU_CX_GMU_WFI_CONFIG   GMU_REG(0x1f802u)
 #define GMU_CM3_FW_BUSY         GMU_REG(0x1f81au)
 #define GMU_CM3_FW_INIT_RESULT  GMU_REG(0x1f81cu)
@@ -2043,10 +2059,11 @@
 	gpu_wr(gpu_gmu, GMU_ICACHE_CONFIG, 1);
 	gpu_wr(gpu_gmu, GMU_DCACHE_CONFIG, 1);
 	gpu_wr(gpu_gmu, GMU_CM3_FW_INIT_RESULT, 0);
-	gpu_wr(gpu_gmu, GMU_CM3_BOOT_CONFIG, 0);
+	gpu_wr(gpu_gmu, GMU_CM3_BOOT_CONFIG, GMU_BOOT_TCM);
 	gpu_wr(gpu_gmu, GMU_AHB_FENCE_RANGE_0, GMU_FENCE_RANGE_MASK);
 	gpu_wr(gpu_gmu, GMU_HFI_SFR_ADDR, 0x06018000u);
-	printf("SWEET GPU: fence-range0 %#x\n",
+	printf("SWEET GPU: boot-cfg %#x fence-range0 %#x\n",
+	    gpu_rd(gpu_gmu, GMU_CM3_BOOT_CONFIG),
 	    gpu_rd(gpu_gmu, GMU_AHB_FENCE_RANGE_0));
 	gpu_gmu_prestart();
 	printf("SWEET GPU: gmu preset done, no gmu read yet\n");
