+/*
+ * Post-GX attempt: open the branch the RCG feeds first, let the gate settle,
+ * then program the mux and force the root. clk_rcg2_enable() writes ROOT_EN
+ * and ignores the ROOT_OFF timeout, so the gate ordering is not pinned down by
+ * the reference driver and is worth one experiment.
+ */
+static bool
+gpu_rcg_root_now(uint32_t cfg, const char *tag)
+{
+	gpu_wr(gpu_cc, GPUCC_GX_GFX3D_CBCR,
+	    gpu_rd(gpu_cc, GPUCC_GX_GFX3D_CBCR) | CBCR_ENABLE);
+	delay(10);
+	gpu_wr(gpu_cc, GPUCC_GX_GFX3D_RCG + 4, cfg);
+	gpu_wr(gpu_cc, GPUCC_GX_GFX3D_RCG, RCG_UPDATE);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (!(gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG) & RCG_UPDATE)) {
+			break;
+		}
+		delay(1);
+	}
+	gpu_wr(gpu_cc, GPUCC_GX_GFX3D_RCG, RCG_ROOT_EN);
+	bool rooted = false;
+	for (unsigned i = 0; i < 10000; ++i) {
+		if (!(gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG) & RCG_ROOT_OFF)) {
+			rooted = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET GPU: %s cfg=%#x cmd=%#x branch=%#x %s\n", tag,
+	    gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG + 4), gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG),
+	    gpu_rd(gpu_cc, GPUCC_GX_GFX3D_CBCR),
+	    rooted ? "rooted" : "root still off");
+	return rooted;
+}
