+static void
+gpu_gmu_report(const char *when)
+{
+	if (!gpu_gmu) {
+		return;
+	}
+	uint32_t sp = gpu_rd(gpu_gmu, GMU_SPTPRAC_PWR_STATUS);
+	uint8_t fence = gpu_rd8(gpu_gmu, GMU_AHB_FENCE_STATUS);
