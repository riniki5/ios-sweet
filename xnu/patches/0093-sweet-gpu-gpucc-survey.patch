--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -521,5 +521,12 @@
 	gpu_dump_at(gpu_cc, "pll0", 0x0, 16);
 	gpu_dump_at(gpu_cc, "pll1", 0x100, 16);
 	gpu_dump_at(gpu_cc, "gmu", 0x1090, 8);
+	/*
+	 * Which CBCRs and RCG registers actually respond: 0x1004/0x107c/0x108c
+	 * read 0 and swallow writes, so the whole 0x1000 window goes out raw.
+	 * 0x101c is the gfx3d RCG, 0x1020 its CFG.
+	 */
+	gpu_dump_at(gpu_cc, "gpucc", 0x1000, 48);
+	gpu_dump_at(gpu_cc, "gxdom", 0x1500, 8);
 }
