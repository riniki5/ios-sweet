+static void
+gpu_core_hw_init(void)
+{
+	uint32_t rev, status, clock_before, clock_after, protect, nc;
+	unsigned i, landed = 0;
+
+	rev = gpu_rd(gpu_core, 0x0);
+	status = gpu_rd(gpu_core, CORE_RBBM_STATUS);
+	clock_before = gpu_rd(gpu_core, CORE_RBBM_CLOCK_CNTL);
+	printf("SWEET GPU: core rev=%#x status=%#x status3=%#x clock=%#x"
+	    " branch=%#x rcg=%#x t=%llu\n", rev, status,
+	    gpu_rd(gpu_core, CORE_RBBM_STATUS3), clock_before,
+	    gpu_rd(gpu_cc, GPUCC_GX_GFX3D_CBCR),
+	    gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG), gpu_uptime_ms());
+	(void)sweet_log_sync();
+	gpu_wr(gpu_gmu, GMU_AO_CGC_MODE, 0x222u);
+	gpu_wr(gpu_gmu, GMU_AO_CGC_DELAY, 0x111u);
+	gpu_wr(gpu_gmu, GMU_AO_CGC_HYST, 0x555u);
+	gpu_wr(gpu_gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL,
+	    gpu_rd(gpu_gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL) & ~1u);
+	for (i = 0; i < sizeof(gpu_a615_hwcg) / sizeof(gpu_a615_hwcg[0]); ++i) {
+		gpu_wr(gpu_core, gpu_a615_hwcg[i].off, gpu_a615_hwcg[i].val);
+	}
+	gpu_wr(gpu_gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL,
+	    gpu_rd(gpu_gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL) | 1u);
+	gpu_wr(gpu_core, CORE_RBBM_CLOCK_CNTL, 0x8aa8aa82u);
+	printf("SWEET GPU: core hwcg %u regs, clock %#x -> %#x\n", i,
+	    clock_before, gpu_rd(gpu_core, CORE_RBBM_CLOCK_CNTL));
+	(void)sweet_log_sync();
+
+	gpu_wr(gpu_core, CORE_VBIF_CLIENT_QOS, 3);
+	gpu_wr(gpu_core, CORE_PERFCTR_BUSY_MASK, 0xffffffffu);
+	/* a6xx_start's UCHE setup: no L2 bypass, then the GMEM window. */
+	gpu_wr(gpu_core, CORE_UCHE_RANGE_MAX_LO, 0xffffffc0u);
+	gpu_wr(gpu_core, CORE_UCHE_RANGE_MAX_HI, 0x0001ffffu);
+	gpu_wr(gpu_core, CORE_UCHE_TRAP_LO, 0xfffff000u);
+	gpu_wr(gpu_core, CORE_UCHE_TRAP_HI, 0x0001ffffu);
+	gpu_wr(gpu_core, CORE_UCHE_THRU_LO, 0xfffff000u);
+	gpu_wr(gpu_core, CORE_UCHE_THRU_HI, 0x0001ffffu);
+	gpu_wr(gpu_core, CORE_UCHE_GMEM_MIN_LO, CORE_UCHE_GMEM_MIN);
+	gpu_wr(gpu_core, CORE_UCHE_GMEM_MIN_HI, 0);
+	gpu_wr(gpu_core, CORE_UCHE_GMEM_MAX_LO, CORE_UCHE_GMEM_MAX);
+	gpu_wr(gpu_core, CORE_UCHE_GMEM_MAX_HI, 0);
+	gpu_wr(gpu_core, CORE_UCHE_FILTER_CNTL, 0x804u);
+	gpu_wr(gpu_core, CORE_UCHE_CACHE_WAYS, 0x4u);
+
+	gpu_wr(gpu_core, CORE_CP_ROQ_THRESH_2, 0x010000c0u);
+	gpu_wr(gpu_core, CORE_CP_ROQ_THRESH_1, 0x8040362cu);
+	gpu_wr(gpu_core, CORE_CP_MEM_POOL_SIZE, 128);
+	gpu_wr(gpu_core, CORE_PC_DBG_ECO_CNTL, 0x300u << 11);
+	gpu_wr(gpu_core, CORE_CP_AHB_CNTL, 1);
+	gpu_wr(gpu_core, CORE_PERFCTR_CNTL, 1);
+
+	/* toco's DT: highest-bank-bit 14, min-access-length 32, ubwc-mode 2. */
+	gpu_wr(gpu_core, CORE_RB_NC_MODE_CNTL, 2);
+	gpu_wr(gpu_core, CORE_TPL1_NC_MODE_CNTL, 2);
+	gpu_wr(gpu_core, CORE_SP_NC_MODE_CNTL, 2);
+	gpu_wr(gpu_core, CORE_UCHE_MODE_CNTL, 1u << 21);
+	gpu_wr(gpu_core, CORE_HANG_INT_CNTL, (1u << 30) | 0xcfffffu);
+	gpu_wr(gpu_core, CORE_UCHE_CLIENT_PF, 1);
+
+	gpu_wr(gpu_core, CORE_CP_PROTECT_CNTL, 3);
+	for (i = 0; i < sizeof(gpu_a615_protect) / sizeof(gpu_a615_protect[0]);
+	    ++i) {
+		gpu_wr(gpu_core, CORE_CP_PROTECT_REG + i * 4u,
+		    gpu_a615_protect[i].base |
+		    (gpu_a615_protect[i].count << 18) |
+		    (gpu_a615_protect[i].read_protect << 31));
+	}
+
+	clock_after = gpu_rd(gpu_core, CORE_RBBM_CLOCK_CNTL);
+	protect = gpu_rd(gpu_core, CORE_CP_PROTECT_CNTL);
+	nc = gpu_rd(gpu_core, CORE_RB_NC_MODE_CNTL);
+	landed += clock_after == 0x8aa8aa82u;
+	landed += protect == 3u;
+	landed += nc == 2u;
+	printf("SWEET GPU: core hw-init done clock=%#x protect=%#x nc=%#x"
+	    " uche-filter=%#x pool=%#x landed=%u/3 rbbm=%#x\n", clock_after,
+	    protect, nc, gpu_rd(gpu_core, CORE_UCHE_FILTER_CNTL),
+	    gpu_rd(gpu_core, CORE_CP_MEM_POOL_SIZE), landed,
+	    gpu_rd(gpu_core, CORE_RBBM_STATUS));
+	(void)sweet_log_sync();
+}
