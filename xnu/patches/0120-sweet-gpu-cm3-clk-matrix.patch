+/* Ring lines are only ordered, not timestamped; the log thread's own period
+ * lags under UFS load, so a wall-clock ms is the only way to tell a 500 ms
+ * wait from a 2 s stall. */
+static uint64_t
+gpu_uptime_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
