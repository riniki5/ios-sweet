  *   | u64 flush sequence
  * ring offset of byte n = n % ring size. Read it from a recovery with
  * tools/sweet-log-pull.sh. Disabled with boot-arg sweetlog=0.
- * The thread flushes every ufslogsecs (default 10) seconds, or every hz/10
- * ticks with sweetlogfast=1. The first write stays behind the first sleep: the
- * build that wrote at t=0 (log43) stops at the log banner and never reaches a
- * second flush.
+ * The thread flushes every ufslogsecs (default 10) seconds; with
+ * sweetlogfast=1 its first SWEET_LOG_FAST_TICKS wakeups come every hz/10
+ * ticks and each prints a tick line, so a ring that ends in tick N says the
+ * thread itself ran N times, and a ring that ends at the banner says it never
+ * got a second turn. After that window it falls back to ufslogsecs. The first
+ * write stays behind the first sleep: the build that wrote at t=0 (log43)
+ * stops at the log banner and never reaches a second flush. A failed write
+ * retries on the next tick instead of ending the thread, so a transient error
+ * no longer looks like a dead machine.
  */
 #define SWEET_LOG_SIZE          (4u << 20)
 #define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
 #define SWEET_LOG_SECS          10u
+#define SWEET_LOG_FAST_TICKS    60u
 
 static char sweet_log_ring[SWEET_LOG_SIZE];
 static uint64_t _Atomic sweet_log_total;
@@ -748,6 +754,7 @@
 {
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
 	uint64_t flushed = 0, seq = 0;
+	unsigned fast = 0, fails = 0;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
 	int wait = sweet_log_fast ? MAX(hz / 10, 1) : hz * (int)sweet_log_secs;
 
@@ -755,6 +762,12 @@
 	    " flush every %d ticks\n", SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base, wait);
 	for (;;) {
 		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", wait);
+		if (sweet_log_fast && fast < SWEET_LOG_FAST_TICKS) {
+			printf("SWEET LOG: tick %u\n", ++fast);
+			if (fast == SWEET_LOG_FAST_TICKS) {
+				wait = hz * (int)sweet_log_secs;
+			}
+		}
 		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
 		if (total == flushed) {
