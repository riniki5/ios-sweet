+		 * Parent 6 is P_GPLL0_OUT_MAIN_DIV, whose 1.5 divider is pre_div 2 in
+		 * the rcg2 encoding (rate = parent * 2 / (pre_div + 1)). */
+		printf("SWEET GPU: gmu_clk_src %#x/%#x -> GPLL0_DIV 200 MHz\n",
+		    rcg, cfg);
+		gpu_wr(gpu_cc, GPUCC_GMU_RCG_CFG, RCG_CFG_GPLL0_DIV200);
 		gpu_wr(gpu_cc, GPUCC_GMU_RCG, RCG_UPDATE);
 		delay(1);
 		gpu_wr(gpu_cc, GPUCC_GMU_RCG, RCG_ROOT_EN);
