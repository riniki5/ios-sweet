-	if (clk && ((rcg & RCG_ROOT_OFF) || !(rcg & RCG_ROOT_EN))) {
-		gpu_wr(gpu_cc, GPUCC_GMU_RCG_CFG, RCG_CFG_XO);
+	if (clk) {
+		/* log57: boot-cfg 0x2 stuck but the CM3 still did not fetch, so the
+		 * next divergence is the rate. Mainline "uses a known rate to bring up
