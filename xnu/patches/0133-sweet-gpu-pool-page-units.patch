+/*
+ * The GMU's address registers hold 32 bits of byte address, so the whole pool
+ * has to sit below 4 GiB. Page numbers count PAGE_SIZE units, which is 16 KiB
+ * on arm64 XNU (log76: pn 0x411ea is byte address 0x1047a8000), so the cap is
+ * computed from PAGE_SHIFT rather than written as a 4 KiB page count.
+ */
+static ppnum_t
+gpu_pool_max_pnum(void)
+{
+	return (ppnum_t)((0x100000000ull >> PAGE_SHIFT) - 1u);
+}
