 /*
+ * gpu_xrel=1: issue the release store from here instead of the boot thread.
+ * If the store never completes, this thread dies with it and the boot thread
+ * still gets to read the TCM the CM3 was told to write.
+ */
+static void
+gpu_cm3_release_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	printf("SWEET GPU: xrel thread up\n");
+	gpu_pause(200);
+	printf("SWEET GPU: xrel issuing sysreset=0\n");
+	gpu_pause(100);
+	gpu_wr(gpu_gmu, GMU_CM3_SYSRESET, 0);
+	printf("SWEET GPU: xrel store returned\n");
+	gpu_pause(1000);
+	printf("SWEET GPU: xrel thread still alive\n");
+}
+
+/*
  * A sixteen-word CM3 program: the image's reset vector and none of its code.
  * Word 0 stays the image's stack pointer (0x43f80, in GMU SRAM), word 1 points
  * at 0x100, and words 2-15 all point there too so an exception lands in the
@@ -1846,6 +1886,8 @@
 	gpu_wr(gpu_gmu, GMU_CM3_BOOT_CONFIG, 0);
 	gpu_wr(gpu_gmu, GMU_AHB_FENCE_RANGE_0, GMU_FENCE_RANGE_MASK);
 	gpu_wr(gpu_gmu, GMU_HFI_SFR_ADDR, 0x06018000u);
+	printf("SWEET GPU: fence-range0 %#x\n",
+	    gpu_rd(gpu_gmu, GMU_AHB_FENCE_RANGE_0));
 	gpu_gmu_prestart();
 	printf("SWEET GPU: gmu preset done, no gmu read yet\n");
 	gpu_pause(300);
@@ -1866,6 +1908,44 @@
 		gpu_gmu_stub(stub);
 		gpu_pause(300);
 	}
+	/*
+	 * The GMU's hardware clock window: gpucc-sdmmagpie.c sets WAKE/SLEEP to
+	 * 0xF at probe, ABL leaves 2/2, and the CM3 is about to start on this gate.
+	 */
+	uint32_t cbcr = gpu_rd(gpu_cc, GPUCC_CX_GMU_CBCR);
+	printf("SWEET GPU: cx-gmu cbcr=%#x wake-sleep=%#x\n", cbcr,
+	    (cbcr >> 4) & 0xffu);
+	gpu_pause(300);
+	gpu_wr(gpu_cc, GPUCC_CX_GMU_CBCR,
+	    (cbcr & ~GPUCC_GMU_CBCR_WAKE_SLEEP) | GPUCC_GMU_CBCR_WAKE_SLEEP);
+	printf("SWEET GPU: cx-gmu cbcr now %#x gx-gmu %#x\n",
+	    gpu_rd(gpu_cc, GPUCC_CX_GMU_CBCR), gpu_rd(gpu_cc, GPUCC_GX_GMU_CBCR));
+	gpu_pause(300);
+	int xrel = 0;
+	PE_parse_boot_argn("gpu_xrel", &xrel, sizeof(xrel));
+	if (xrel) {
+		thread_t th;
+
+		printf("SWEET GPU: xrel release from a second thread\n");
+		gpu_pause(300);
+		if (kernel_thread_start(gpu_cm3_release_thread, NULL, &th) !=
+		    KERN_SUCCESS) {
+			printf("SWEET GPU: xrel thread start failed\n");
+		} else {
+			thread_deallocate(th);
+		}
+		gpu_pause(800);
+		printf("SWEET GPU: xrel main alive after release window\n");
+		gpu_pause(300);
+		printf("SWEET GPU: xrel sentinel=%#x\n",
+		    gpu_rd(gpu_gmu, GMU_CM3_ITCM + 0x130));
+		gpu_pause(300);
+		printf("SWEET GPU: xrel fw-init=%#x reset=%#x\n",
+		    gpu_rd(gpu_gmu, GMU_CM3_FW_INIT_RESULT),
+		    gpu_rd(gpu_gmu, GMU_CM3_SYSRESET));
+		gpu_pause(300);
+		return false;
+	}
 	printf("SWEET GPU: releasing cm3: wfi=0\n");
 	gpu_pause(300);
 	gpu_wr(gpu_gmu, GMU_CX_GMU_WFI_CONFIG, 0);
