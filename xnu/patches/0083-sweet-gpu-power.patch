+/*
+ * SWEET Adreno 618 (a615, kgsl chipid 0x06010800) power probe.
+ * Call once after the scheduler is running; boot arg gpu=1.
+ * Mirrors the gpucc/gcc/gdsc register sequences of msm-4.14
+ * (gpucc-sdmmagpie, gcc-sdmmagpie, gdsc-regulator): branch clocks, then the
+ * CX GDSC, then (gpu_gx=1) the GX root clock and GX GDSC with its resets.
+ * No rail votes: sweet_rpmh.c speaks only the PMIC5 LDO policy, so the CX/GX
+ * levels are whatever ABL left (the display proves CX is up). No GPU
+ * firmware, HFI, SMMU, or command submission; register reads only after the
+ * domain reports powered. See gpu-report.md.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_gpu_init(void);
+
+#define GPU_PA          0x05000000u
+#define GPUCC_PA        0x05090000u
+#define GCC_PA          0x00100000u
+
+/* GCC gpu branches (gcc-sdmmagpie.c). */
+#define GCC_GPU_CFG_AHB_CBCR    0x71004u
+#define GCC_GPU_MEMNOC_CBCR     0x7100cu
+#define GCC_GPU_SNOC_DVM_CBCR   0x71018u
+#define GCC_GPU_GPLL0_CTL       0x52004u
+
+/* GPUCC (gpucc-sdmmagpie.c; regmap stride 4, max 0x8008). */
+#define GPUCC_GX_SW_RESET       0x1008u
+#define GPUCC_GX_GDSCR          0x100cu
+#define GPUCC_GX_GFX3D_RCG      0x101cu
+#define GPUCC_GX_GFX3D_CBCR     0x1054u
+#define GPUCC_GX_VSENSE_CBCR    0x1058u
+#define GPUCC_GX_CXO_CBCR       0x1060u
+#define GPUCC_CX_GDSCR          0x106cu
+#define GPUCC_AHB_CBCR          0x1078u
+#define GPUCC_CX_APB_CBCR       0x1088u
+#define GPUCC_CX_SNOC_DVM_CBCR  0x108cu
+#define GPUCC_CX_CXO_CBCR       0x109cu
+#define GPUCC_CX_GFX3D_CBCR     0x10a4u
+#define GPUCC_GX_DOMAIN         0x1508u
+#define GPUCC_CX_GDSCR_STATUS   0x1540u
+
+#define CBCR_ENABLE     (1u << 0)
+#define CBCR_HW_CTL     (1u << 1)
+#define CBCR_CLK_OFF    (1u << 31)
+#define GDSC_SW_COLLAPSE (1u << 0)
+#define GDSC_HW_CTRL    (1u << 1)
+#define GDSC_PWR_ON     (1u << 31)
+#define GDSC_GMEM_CLAMP_IO (1u << 0)
+#define GDSC_GMEM_RESET (1u << 4)
+#define BCR_BLK_ARES    (1u << 0)
+#define RCG_UPDATE      (1u << 0)
+#define RCG_ROOT_EN     (1u << 1)
+#define RCG_CFG_DUAL_EDGE_TCXO  (0u | (2u << 8))  /* src 0 = BI_TCXO, map_2 */
+
+static vm_offset_t gpu_cc, gpu_gcc, gpu_core;
+static bool gpu_dead;
+
+static uint32_t
+gpu_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gpu_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+gpu_clock_on(vm_offset_t base, uint32_t off, const char *name)
+{
+	uint32_t v = gpu_rd(base, off);
+
+	if (v == 0xffffffffu) {
+		printf("SWEET GPU: %s @%#x reads %#x, block not answering\n", name, off, v);
+		return false;
+	}
+	printf("SWEET GPU: %s @%#x = %#x (%s%s%s)\n", name, off, v,
+	    (v & CBCR_ENABLE) ? "on" : "off",
+	    (v & CBCR_HW_CTL) ? " hw-ctl" : "",
+	    (v & CBCR_CLK_OFF) ? " clk-off" : "");
+	if (!(v & CBCR_CLK_OFF)) {
+		return true;
+	}
+	if (v & CBCR_HW_CTL) {
+		/* Voted/HW branches are not ours to drive from SW. */
+		printf("SWEET GPU: %s is under HW control, leaving it alone\n", name);
+		return false;
+	}
+	gpu_wr(base, off, v | CBCR_ENABLE);
+	for (unsigned i = 0; i < 100; ++i) {
+		if (!(gpu_rd(base, off) & CBCR_CLK_OFF)) {
+			printf("SWEET GPU: %s enabled\n", name);
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET GPU: %s did not halt, now %#x\n", name, gpu_rd(base, off));
+	return false;
+}
+
+static bool
+gdsc_poll_on(vm_offset_t base, uint32_t status_off, const char *name, unsigned us)
+{
+	for (unsigned i = 0; i < us; ++i) {
+		if (gpu_rd(base, status_off) & GDSC_PWR_ON) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET GPU: %s PWR_ON timeout, status %#x\n", name, gpu_rd(base, status_off));
+	return false;
+}
+
+static bool
+gdsc_power(vm_offset_t base, uint32_t gdscr, uint32_t status, const char *name, unsigned us)
+{
+	uint32_t v = gpu_rd(base, gdscr);
+
+	printf("SWEET GPU: %s gdscr=%#x status=%#x\n", name, v, gpu_rd(base, status));
+	if (gpu_rd(base, status) & GDSC_PWR_ON) {
+		return true;
+	}
+	if (v & GDSC_HW_CTRL) {
+		printf("SWEET GPU: %s is under HW control, refusing SW collapse\n", name);
+		return false;
+	}
+	gpu_wr(base, gdscr, v & ~GDSC_SW_COLLAPSE);
+	delay(1);
+	bool on = gdsc_poll_on(base, status, name, us);
+	printf("SWEET GPU: %s %s, gdscr=%#x status=%#x\n", name, on ? "up" : "still down",
+	    gpu_rd(base, gdscr), gpu_rd(base, status));
+	return on;
+}
+
+static void
+gpu_dump(const char *what, uint32_t off, unsigned words)
+{
+	for (unsigned i = 0; i < words; i += 4) {
+		printf("SWEET GPU: %s %#06x: %08x %08x %08x %08x\n", what, off + i * 4,
+		    gpu_rd(gpu_core, off + (i + 0) * 4), gpu_rd(gpu_core, off + (i + 1) * 4),
+		    gpu_rd(gpu_core, off + (i + 2) * 4), gpu_rd(gpu_core, off + (i + 3) * 4));
+	}
+}
+
+void
+sweet_gpu_init(void)
+{
+	int on = 0, gx = 0;
+	PE_parse_boot_argn("gpu", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	PE_parse_boot_argn("gpu_gx", &gx, sizeof(gx));
+	gpu_gcc = ml_io_map(GCC_PA, 0x100000);
+	gpu_cc = ml_io_map(GPUCC_PA, 0x9000);
+	gpu_core = ml_io_map(GPU_PA, 0x40000);
+	if (!gpu_gcc || !gpu_cc || !gpu_core) {
+		printf("SWEET GPU: register mapping failed\n");
+		return;
+	}
+	uint32_t ahb = gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CBCR);
+	uint32_t gpll = gpu_rd(gpu_gcc, GCC_GPU_GPLL0_CTL);
+	printf("SWEET GPU: gcc gpu-cfg-ahb=%#x gpu-gpll0-ctl=%#x\n", ahb, gpll);
+	if (ahb == 0xffffffffu) {
+		printf("SWEET GPU: GCC not answering, aborting\n");
+		return;
+	}
+	/* GPUCC itself is reachable only with this branch on. */
+	if (!gpu_clock_on(gpu_gcc, GCC_GPU_CFG_AHB_CBCR, "gcc_gpu_cfg_ahb_clk")) {
+		printf("SWEET GPU: no GPUCC access without the config AHB clock\n");
+		return;
+	}
+	if (gpu_rd(gpu_cc, GPUCC_AHB_CBCR) == 0xffffffffu) {
+		printf("SWEET GPU: gpucc reads all ones, aborting\n");
+		return;
+	}
+	/* Halt checks read CLK_OFF; enabling the branch again is idempotent. */
+	gpu_clock_on(gpu_cc, GPUCC_AHB_CBCR, "gpu_cc_ahb_clk");
+	gpu_clock_on(gpu_cc, GPUCC_CX_APB_CBCR, "gpu_cc_cx_apb_clk");
+	gpu_clock_on(gpu_cc, GPUCC_CX_SNOC_DVM_CBCR, "gpu_cc_cx_snoc_dvm_clk");
+	gpu_clock_on(gpu_cc, GPUCC_CX_CXO_CBCR, "gpu_cc_cxo_clk");
+
+	bool cx = gdsc_power(gpu_cc, GPUCC_CX_GDSCR, GPUCC_CX_GDSCR_STATUS,
+	    "gpu_cx_gdsc", 500);
+	if (!cx) {
+		printf("SWEET GPU: CX domain down; the CX rail level must be voted\n");
+		return;
+	}
+	if (!gx) {
+		printf("SWEET GPU: CX on; pass gpu_gx=1 to power GX and read the chip id\n");
+		return;
+	}
+	printf("SWEET GPU: gx sw-reset=%#x domain=%#x gdscr=%#x rcg=%#x/%#x branch=%#x\n",
+	    gpu_rd(gpu_cc, GPUCC_GX_SW_RESET), gpu_rd(gpu_cc, GPUCC_GX_DOMAIN),
+	    gpu_rd(gpu_cc, GPUCC_GX_GDSCR), gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG),
+	    gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG + 4), gpu_rd(gpu_cc, GPUCC_GX_GFX3D_CBCR));
+	/* The GDSC needs a root clock; only reprogram the RCG if its root is off. */
+	uint32_t rcg = gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG);
+	if (!(rcg & RCG_ROOT_EN)) {
+		gpu_wr(gpu_cc, GPUCC_GX_GFX3D_RCG + 4, RCG_CFG_DUAL_EDGE_TCXO);
+		gpu_wr(gpu_cc, GPUCC_GX_GFX3D_RCG, RCG_ROOT_EN | RCG_UPDATE);
+		printf("SWEET GPU: gfx3d RCG rooted at XO, now %#x/%#x\n",
+		    gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG), gpu_rd(gpu_cc, GPUCC_GX_GFX3D_RCG + 4));
+	}
+	gpu_clock_on(gpu_cc, GPUCC_GX_CXO_CBCR, "gpu_cc_gx_cxo_clk");
+	gpu_clock_on(gpu_cc, GPUCC_GX_VSENSE_CBCR, "gpu_cc_gx_vsense_clk");
+	gpu_clock_on(gpu_cc, GPUCC_GX_GFX3D_CBCR, "gpu_cc_gx_gfx3d_clk");
+
+	/* gdsc-regulator: block ares, then AON gmem reset, then IO clamp off. */
+	uint32_t reset = gpu_rd(gpu_cc, GPUCC_GX_SW_RESET);
+	gpu_wr(gpu_cc, GPUCC_GX_SW_RESET, reset | BCR_BLK_ARES);
+	delay(1);
+	gpu_wr(gpu_cc, GPUCC_GX_SW_RESET, reset & ~BCR_BLK_ARES);
+	uint32_t domain = gpu_rd(gpu_cc, GPUCC_GX_DOMAIN);
+	gpu_wr(gpu_cc, GPUCC_GX_DOMAIN, domain | GDSC_GMEM_RESET);
+	delay(1);
+	domain &= ~GDSC_GMEM_RESET;
+	gpu_wr(gpu_cc, GPUCC_GX_DOMAIN, domain & ~GDSC_GMEM_CLAMP_IO);
+	if (!gdsc_power(gpu_cc, GPUCC_GX_GDSCR, GPUCC_GX_GDSCR, "gpu_gx_gdsc", 1000)) {
+		printf("SWEET GPU: GX domain down; the GX rail level must be voted\n");
+		return;
+	}
+	uint32_t rev = gpu_rd(gpu_core, 0x0);
+	printf("SWEET GPU: RBBM_REVISION_ID=%#x (expect 0x6010800)\n", rev);
+	if (rev != 0 && rev != 0xffffffffu) {
+		printf("SWEET GPU: major %u minor %u patch %u micro %u\n",
+		    (rev >> 24) & 0xffu, (rev >> 16) & 0xffu,
+		    (rev >> 8) & 0xffu, rev & 0xffu);
+	}
+	gpu_dump("rbbm", 0x0, 16);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
