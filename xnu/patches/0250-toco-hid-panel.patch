diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -30,6 +30,7 @@
 #include "IOHIDKeys.h"
 #include "IOHIDPrivateKeys.h"
 #include "IOHIDUsageTables.h"
+#include <pexpert/device_tree.h>
 
 extern "C" uint64_t mach_absolute_time(void);
 
@@ -372,7 +373,9 @@
 	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 2; }
 private:
 	IOLock *fLock;
+	int fPanelW, fPanelH;                   /* native digitizer size */
 	int fLogicalW, fLogicalH, fOffX, fOffY;
+	bool fStretch;                          /* presenter scales the logical display to the panel */
 	bool fDown[SWEET_TOUCH_FINGERS];
 	bool fEdge[SWEET_TOUCH_FINGERS];
 	IOFixed fX[SWEET_TOUCH_FINGERS];
@@ -437,23 +440,42 @@
 	if (!fLock || !IOHIDEventService::start(provider)) {
 		return false;
 	}
+	/* Native panel size comes from this boot's ADT; keep sweet defaults for older ADTs. */
+	fPanelW = 1080;
+	fPanelH = 2400;
+	DTEntry entry;
+	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) == kSuccess) {
+		uint32_t const *val;
+		unsigned int size;
+		if (SecureDTGetProperty(entry, "width", (void const **)&val, &size) == kSuccess &&
+		    size >= sizeof(*val) && *val) {
+			fPanelW = (int)*val;
+		}
+		if (SecureDTGetProperty(entry, "height", (void const **)&val, &size) == kSuccess &&
+		    size >= sizeof(*val) && *val) {
+			fPanelH = (int)*val;
+		}
+	}
 	uint32_t lw, lh;
-	sweet_fb_logical_size(1080, 2400, &lw, &lh);   /* SweetFramebuffer.cpp */
-	if (sweet_fb_scaled()) {
-		lw = 1080;      /* the whole display scaled onto the whole panel: panel fractions */
-		lh = 2400;
+	sweet_fb_logical_size((uint32_t)fPanelW, (uint32_t)fPanelH, &lw, &lh);
+	fStretch = sweet_fb_scaled();
+	if (fStretch) {
+		/* The whole logical display is scaled onto the whole panel. */
+		lw = (uint32_t)fPanelW;
+		lh = (uint32_t)fPanelH;
 	}
 	fLogicalW = (int)lw;
 	fLogicalH = (int)lh;
-	fOffX = (fLogicalW - 1080) / 2;
-	fOffY = (fLogicalH - 2400) / 2;
+	fOffX = fStretch ? 0 : (fLogicalW - fPanelW) / 2;
+	fOffY = fStretch ? 0 : (fLogicalH - fPanelH) / 2;
 	/* The digitizer covers the main display (backboardd maps it 1:1). */
 	setProperty("DisplayIntegrated", kOSBooleanTrue);
 	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
 	setProperty("SurfaceHeight", (unsigned long long)(151 << 16), 32);
 	gSweetTouch = this;
 	registerService();
-	IOLog("SWEET HID: touch registered\n");
+	IOLog("SWEET HID: touch registered, panel %dx%d presented as %dx%d\n",
+	    fPanelW, fPanelH, fLogicalW, fLogicalH);
 	return true;
 }
 
@@ -467,14 +489,14 @@
 	if (finger < 0 || finger >= SWEET_TOUCH_FINGERS) {
 		return;
 	}
-	x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
-	y = y < 0 ? 0 : (y > 2399 ? 2399 : y);
+	x = x < 0 ? 0 : (x >= fPanelW ? fPanelW - 1 : x);
+	y = y < 0 ? 0 : (y >= fPanelH ? fPanelH - 1 : y);
 
 	IOLockLock(fLock);
 	bool was = fDown[finger];
-	/* Panel pixels -> the presented display (SweetFramebuffer.cpp); a touch in a black band
-	 * lands on the display's nearest row. */
-	int lx = x + fOffX, ly = y + fOffY;
+	/* Panel pixels -> presented coordinates. Scaled mode maps the whole panel 1:1 in fractions. */
+	int lx = fStretch ? x : x + fOffX;
+	int ly = fStretch ? y : y + fOffY;
 	lx = lx < 0 ? 0 : (lx > fLogicalW - 1 ? fLogicalW - 1 : lx);
 	ly = ly < 0 ? 0 : (ly > fLogicalH - 1 ? fLogicalH - 1 : ly);
 	IOFixed nx = (IOFixed)(((int64_t)lx << 16) / fLogicalW);
@@ -485,8 +507,10 @@
 		return;
 	}
 	if (!was && down) {
-		fEdge[finger] = x < SWEET_TOUCH_EDGE_PX || x > 1079 - SWEET_TOUCH_EDGE_PX ||
-		    y < SWEET_TOUCH_EDGE_PX || y > 2399 - SWEET_TOUCH_EDGE_PX;
+		/* Toco's reported contact area stops ~54 px above the bottom of its panel. */
+		int bottomEdge = fPanelH == 2340 ? fPanelH / 20 : SWEET_TOUCH_EDGE_PX;
+		fEdge[finger] = x < SWEET_TOUCH_EDGE_PX || x >= fPanelW - SWEET_TOUCH_EDGE_PX ||
+		    y < SWEET_TOUCH_EDGE_PX || y >= fPanelH - bottomEdge;
 	}
 
 	collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
