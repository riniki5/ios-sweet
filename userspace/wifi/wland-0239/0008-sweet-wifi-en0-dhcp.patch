+static void l3_poll(void)
+{
+	int status;
+	pid_t pid;
+	while ((pid = waitpid(-1, &status, WNOHANG)) > 0) {
+		if (pid != l3_pid)
+			continue;
+		printf("l3: DHCP client exited (status %#x); restarting\n", status);
+		l3_pid = 0;
+		l3_restart_ms = link_ms() + 2000;
+	}
+	if (!l3_pid && link_ms() >= l3_restart_ms)
+		l3_start();
