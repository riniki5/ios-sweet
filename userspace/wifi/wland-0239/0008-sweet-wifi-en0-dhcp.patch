+	kill(l3_pid, SIGTERM);
+	for (unsigned attempt = 0; attempt < 100; attempt++) {
+		int status;
+		if (waitpid(l3_pid, &status, WNOHANG) == l3_pid) {
+			l3_pid = 0;
+			return;
+		}
+		usleep(20000);
+	}
+	kill(l3_pid, SIGKILL);
+	waitpid(l3_pid, NULL, 0);
+	l3_pid = 0;
+}
